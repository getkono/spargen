# libFuzzer dictionary for the `frontend` target: the tokens an OpenAPI 3.1/3.2 description is
# built from, so mutation reaches document assembly, resolution and lowering rather than stopping
# at the parsers. Use it with `cargo +nightly fuzz run frontend -- -dict=fuzz/dict/openapi.dict`.
# Keys are quoted with their JSON quotes, so one insertion makes a well-formed key in either parser.

# JSON and YAML structure
"{"
"}"
"["
"]"
":"
","
": "
"\x0a"
"\x0a  "
"- "
"---"
"null"
"true"
"false"
"~"
"&a"
"*a"
"<<"
"!!str"

# Document root
"\"openapi\""
"\"3.1.0\""
"\"3.1.1\""
"\"3.2.0\""
"\"3.0.3\""
"\"$self\""
"\"jsonSchemaDialect\""
"\"info\""
"\"title\""
"\"version\""
"\"servers\""
"\"url\""
"\"variables\""
"\"paths\""
"\"webhooks\""
"\"components\""
"\"security\""
"\"tags\""
"\"externalDocs\""

# Path Item and Operation Objects
"\"/{id}\""
"\"get\""
"\"put\""
"\"post\""
"\"delete\""
"\"options\""
"\"head\""
"\"patch\""
"\"trace\""
"\"query\""
"\"additionalOperations\""
"\"operationId\""
"\"summary\""
"\"description\""
"\"deprecated\""
"\"parameters\""
"\"requestBody\""
"\"responses\""
"\"callbacks\""

# Parameter, Header, Media Type and Encoding Objects
"\"name\""
"\"in\""
"\"path\""
"\"querystring\""
"\"header\""
"\"cookie\""
"\"required\""
"\"style\""
"\"form\""
"\"simple\""
"\"label\""
"\"matrix\""
"\"spaceDelimited\""
"\"pipeDelimited\""
"\"deepObject\""
"\"explode\""
"\"allowReserved\""
"\"content\""
"\"schema\""
"\"itemSchema\""
"\"encoding\""
"\"contentType\""
"\"headers\""
"\"application/json\""
"\"application/xml\""
"\"application/octet-stream\""
"\"application/x-www-form-urlencoded\""
"\"multipart/form-data\""
"\"text/plain\""
"\"text/event-stream\""
"\"application/jsonl\""
"\"application/x-ndjson\""
"\"application/json-seq\""

# Responses Object
"\"default\""
"\"200\""
"\"201\""
"\"204\""
"\"2XX\""
"\"404\""
"\"4XX\""
"\"5XX\""
"\"links\""

# Components Object
"\"schemas\""
"\"securitySchemes\""
"\"requestBodies\""
"\"examples\""
"\"pathItems\""
"\"mediaTypes\""

# Security Scheme Object
"\"apiKey\""
"\"http\""
"\"oauth2\""
"\"openIdConnect\""
"\"mutualTLS\""
"\"scheme\""
"\"bearer\""
"\"basic\""
"\"bearerFormat\""
"\"flows\""

# Schema Object keywords
"\"$ref\""
"\"$id\""
"\"$anchor\""
"\"$dynamicRef\""
"\"$dynamicAnchor\""
"\"$defs\""
"\"$schema\""
"\"type\""
"\"properties\""
"\"additionalProperties\""
"\"patternProperties\""
"\"propertyNames\""
"\"unevaluatedProperties\""
"\"items\""
"\"prefixItems\""
