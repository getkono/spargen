    ///Response `204`: No Content
    #[inline]
    pub async fn upload_additional(
        &self,
        body: &types::RequestBody1654af29,
    ) -> Result<support::ResponseValue<()>, support::Error<UploadAdditionalError>> {
        let mut path = "/upload/additional".to_owned();
        let mut query: Vec<String> = Vec::new();
        let url = support::build_url_on(&self.core, None, &path, &query)
            .map_err(support::Error::widen)?;
        let mut request = self.core.http().request(reqwest::Method::POST, url);
        let mut form = reqwest::multipart::Form::new();
        let mut part = reqwest::multipart::Part::text(body.caption.to_string());
        part = part
            .mime_str("text/plain")
            .map_err(support::Error::request_construction)?;
        form = form.part("caption", part);
        for (name, value) in &body.additional {
            if matches!(name.as_str(), "caption") {
                continue;
            }
            let mut part = reqwest::multipart::Part::text(
                serde_json::to_string(value)
                    .map_err(support::Error::request_construction)?,
            );
            part = part
                .mime_str("application/json")
                .map_err(support::Error::request_construction)?;
            form = form.part(name.clone(), part);
        }
        request = request.multipart(form);
        let request = request.build().map_err(support::Error::request_construction)?;
        let response = support::send(&self.core, request)
            .await
            .map_err(support::Error::widen)?;
        if response.status().is_success() {
            let status = response.status();
            let headers = response.headers().clone();
            Ok(support::ResponseValue::new(status, headers, ()))
        } else {
            Err(
                support::unexpected_status::<UploadAdditionalError>(&self.core, response)
                    .await,
            )
        }
    }
