        }
        #[derive(Debug, Default, PartialEq, Eq)]
        struct SseMetadata {
            id: Option<String>,
            retry: Option<u64>,
        }
        #[derive(Debug, Default)]
        struct SseFields {
            data: Vec<u8>,
            event: Option<Vec<u8>>,
            id: Option<Vec<u8>>,
            retry: Option<u64>,
        }
