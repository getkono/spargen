        /// A status selector an operation documents a response under. Generated code passes these as
        /// static tables so classification distinguishes documented from undocumented statuses, and
        /// matches them to pick a multi-status response's variant on either side.
        #[derive(Debug, Clone, Copy)]
        pub enum StatusSpec {
            /// An exact status code, e.g. `404`.
            Exact(u16),
            /// A status range by leading digit, e.g. `Range(5)` for `5XX`.
            Range(u8),
            /// The `default` response — matches any status.
            Any,
        }
        impl StatusSpec {
            /// Whether the selector covers the given status.
            pub fn matches(self, status: reqwest::StatusCode) -> bool {
                match self {
                    StatusSpec::Exact(code) => status.as_u16() == code,
                    StatusSpec::Range(prefix) => {
                        status.as_u16() / 100 == u16::from(prefix)
                    }
                    StatusSpec::Any => true,
                }
            }
        }
        /// Classify a non-success response: a documented status parses into the operation's typed error
        /// body ([`Error::Api`], #6, falling back to [`Error::Decode`] on parse failure); an undocumented
        /// status becomes [`Error::UnexpectedStatus`] (#7) with the raw body preserved. Retains at most
        /// `max_error_body` bytes either way.
        pub async fn classify_error<E>(
            core: &ClientCore,
            response: Response,
            documented: &[StatusSpec],
        ) -> Error<E>
        where
            E: DeserializeOwned,
        {
            classify_with(
                    core,
                    response,
                    documented,
                    |body| {
                        serde_json::from_slice::<E>(body)
                            .map_err(|error| error.to_string())
                    },
                )
                .await
        }
        /// Classify a documented textual error body, preserving the same cap and taxonomy as JSON errors.
        /// A documented body that is not UTF-8, or whose text `E` rejects, is [`Error::Decode`]; an empty
        /// body is decoded like any other, as [`decode_text_body`] describes.
        pub async fn classify_error_text<E>(
            core: &ClientCore,
            response: Response,
            documented: &[StatusSpec],
        ) -> Error<E>
        where
            E: DeserializeOwned,
        {
            classify_with(
                    core,
                    response,
                    documented,
                    |body| { decode_text_body::<E>(body) },
                )
                .await
        }
        /// The body every error classifier shares: read the body capped at `max_error_body`; a status a
        /// `documented` selector matches runs `decode` over it ([`Error::Api`], or [`Error::Decode`]
        /// carrying the decoder's message as its `path` on failure); any other status is
        /// [`Error::UnexpectedStatus`] with the raw body preserved. `decode` receives the `Bytes` itself so
        /// a raw binary error body keeps it without a copy.
        ///
        /// Generated code for a multi-status error enum calls it from the arm whose selector matched, with
        /// that selector as `documented` and a `decode` that builds that arm's variant, as the success side
        /// calls [`decode_success_with`].
        pub async fn classify_with<E>(
            core: &ClientCore,
            response: Response,
            documented: &[StatusSpec],
            decode: impl FnOnce(&Bytes) -> Result<E, String>,
        ) -> Error<E> {
            let (status, headers, body, truncated) = match read_error_body(
                    core,
                    response,
                )
                .await
            {
                Ok(parts) => parts,
                Err(error) => return error,
            };
            if !documented.iter().any(|spec| spec.matches(status)) {
                return Error::UnexpectedStatus {
                    status,
                    headers,
                    body,
                };
            }
            match decode(&body) {
                Ok(value) => Error::Api(ResponseValue::new(status, headers, value)),
                Err(path) => {
                    Error::Decode {
                        status,
                        headers,
                        path,
                        body,
                        truncated,
                    }
                }
            }
        }
        /// Classify a documented raw-byte error body without passing it through a structured decoder.
        ///
        /// Retains at most `max_error_body` bytes either way, as `ClientConfig::max_error_body` documents.
        pub async fn classify_error_bytes<E: From<Bytes>>(
            core: &ClientCore,
            response: Response,
            documented: &[StatusSpec],
        ) -> Error<E> {
            classify_with(core, response, documented, |body| Ok(E::from(body.clone())))
                .await
        }
        /// Wrap a non-success response as [`Error::UnexpectedStatus`] (#7) for operations that document no
        /// error body at all, retaining at most `max_error_body` bytes.
        pub async fn unexpected_status<E>(
            core: &ClientCore,
            response: Response,
        ) -> Error<E> {
            unexpected_status_capped(core.config().max_error_body, response).await
        }
        /// [`unexpected_status`] under an explicit `max_error_body` cap, for a caller that holds the cap
        /// rather than the whole [`ClientCore`]: a streaming response's reconnect. With no selector
        /// documented, [`classify_with`] would answer every status this way.
        pub(crate) async fn unexpected_status_capped<E>(
            max_error_body: usize,
            response: Response,
        ) -> Error<E> {
            match read_error_body_capped(max_error_body, response).await {
                Ok((status, headers, body, _truncated)) => {
                    Error::UnexpectedStatus {
                        status,
                        headers,
                        body,
                    }
                }
                Err(error) => error,
            }
        }
        /// Truncate a body to the retention cap, **copying** the retained prefix rather than slicing it.
        /// Returns the retained bytes and whether any were dropped.
        ///
        /// The copy is unconditional, including when nothing is truncated, because a `Bytes` does not
        /// reveal how much memory stands behind it and every source here can hand over more than it holds:
        /// `Bytes::slice` is a refcounted view onto the whole original; `BytesMut::freeze` hands over the
        /// buffer at its doubled capacity; and a body read whole can be a view sharing the transport's
        /// read buffer. Retention is documented as bounded by the cap, so the only way to mean it is to
        /// detach every time. The cost is one copy of at most `cap` bytes, on error paths only.
        pub(crate) fn cap_body(body: Bytes, cap: usize) -> (Bytes, bool) {
            let retained = body.len().min(cap);
            (Bytes::copy_from_slice(&body[..retained]), body.len() > cap)
        }
        /// Read a response body, retaining at most `max_error_body` bytes.
        ///
        /// The body is pulled incrementally and abandoned at the first chunk that carries it past the cap,
        /// so peak memory depends on the cap (plus one transport chunk, and the retained copy `cap_body`
        /// makes) rather than on whatever the server chose to send; `reqwest` imposes no response size
        /// limit of its own. Abandoning the body forgoes reuse of that connection; a deployment that would
        /// rather keep it raises the cap. A body the backend delivers whole arrives as one chunk, so there
        /// only *retention* is bounded, not peak memory. `ReqwestBackend` delivers every `fetch` body on
        /// `wasm32` whole, including an error body of a streaming operation and of a reconnect, because
        /// only `EventStream` reads a body chunk by chunk there.
        async fn read_capped<E>(
            cap: usize,
            mut body: HttpBody,
        ) -> Result<(Bytes, bool), Error<E>> {
            let mut buffered = bytes::BytesMut::with_capacity(cap.min(16 * 1024));
            while buffered.len() <= cap {
                match body.chunk().await.map_err(Error::from_transport)? {
                    Some(chunk) => buffered.extend_from_slice(&chunk),
                    None => break,
                }
            }
            Ok(cap_body(buffered.freeze(), cap))
        }
    }
    mod error {
        use bytes::Bytes;
        use reqwest::header::HeaderMap;
        use reqwest::StatusCode;
        use serde_json::{Map, Value};
        use super::{AuthError, ResponseValue};
        /// The closed error taxonomy shared by every spargen-generated client. `E` is the
        /// operation's typed error body (an enum when several error statuses are documented).
        ///
        /// Ten variants are constructed: classes #1 to #9, and #11. Taxonomy class #10, cancellation, is a
        /// documented drop-safety guarantee rather than a variant: dropping a returned future is safe and
        /// side-effect-free beyond standard HTTP semantics. The enum implements [`std::error::Error`], whose `source()` reaches
        /// each retained cause, and `Debug` never leaks secrets.
        #[derive(Debug)]
        #[non_exhaustive]
        pub enum Error<E> {
            /// #1 — a request could not be built, or failed inside the send before that request produced
            /// a response. Read it as a statement about *one* request, not about the operation: it is
            /// neither proof that nothing reached the server, nor proof that no response was already
            /// produced and delivered to the caller.
            ///
            /// [`RequestError`] types the three credential causes, each raised before anything is sent;
            /// every other cause arrives as [`RequestError::Other`], whose documentation says which of
            /// them are raised before anything is sent and which are not. Read it before retrying.
            RequestConstruction(RequestError),
            /// #2 — DNS failure, connection refused/reset, TLS handshake or certificate error.
            Transport(TransportError),
            /// #3 — connect vs total-request timeout (as configured on the injected client).
            Timeout(TimeoutKind),
            /// #4 — malformed HTTP or decompression failure. On native targets, a response body the
            /// connection cut short is not this class but [`Error::InterruptedBody`]; on `wasm32`, a
            /// non-streamed one is this class, as [`Error::InterruptedBody`] describes.
            Protocol(ProtocolError),
            /// #5 — redirect-policy exhaustion (per the injected client's policy).
            Redirect(RedirectError),
            /// #6 — a documented non-success status parsed into the operation's typed error body.
            Api(ResponseValue<E>),
            /// #7 — an undocumented status; the raw body is preserved for forensics.
            UnexpectedStatus {
                /// The response status.
                status: StatusCode,
                /// The response headers.
                headers: HeaderMap,
                /// The raw response body, capped as `ClientConfig::max_error_body` documents.
                body: Bytes,
            },
            /// #8 — the response body failed to deserialize; retains the status and headers the response
            /// carried, the decoder's error message, and the raw body, capped on every path but the one
            /// named on `body` below. A documented error status whose body does not match its schema (a
            /// problem `type` the description does not list, or an HTML page from a proxy in front of the
            /// server) arrives here with its status and headers intact, so the caller can still act on
            /// them — honour a `Retry-After` on a `429`, say.
            Decode {
                /// The status of the response whose body failed to decode: a success status when a
                /// success body did not match its schema, the documented error status when a documented
                /// error body did not. For `EventStream`'s per-frame decode, it is the status of the
                /// response the frame was read from — after a reconnect, the reconnected response's.
                status: StatusCode,
                /// The headers of the response whose body failed to decode — for `EventStream`'s
                /// per-frame decode, of the response the frame was read from, as for `status`.
                headers: HeaderMap,
                /// The decoder's error message, held as the decoder wrote it; `Display` escapes its
                /// control characters, since the message may quote server-supplied input.
                path: String,
                /// The retained raw body, capped at `max_error_body`, except on `EventStream`'s per-frame
                /// decode, which `ClientConfig::max_stream_frame` bounds instead.
                body: Bytes,
                /// Whether bytes were dropped from `body` to meet a cap: `false` means nothing was dropped.
                truncated: bool,
            },
            /// #9 — the connection dropped partway through a response body: mid-stream on a streamed
            /// response, or, on native targets, while any other response body, success or error, was
            /// being read. On `wasm32`, the `fetch` backend reports a non-streamed body that fails to
            /// read as a JavaScript error, which carries no evidence that the connection gave out, so
            /// that failure is [`Error::Protocol`] there.
            InterruptedBody(TransportError),
            /// #11 — a `LinkPaginator` page's `rel="next"` link named a URL the paginator had already
            /// fetched (a self-link, or a longer cycle such as page 1 → page 2 → page 1), so following it
            /// would never end. Every page before it was yielded; nothing was sent for `url`.
            PaginationCycle {
                /// The revisited URL the `next` link resolved to.
                url: reqwest::Url,
            },
        }
        impl<E> Error<E> {
            /// Build a request-construction error from any owned error value.
            pub fn request_construction(
                source: impl std::error::Error + Send + Sync + 'static,
            ) -> Self {
                Self::RequestConstruction(
                    RequestError::Other(RequestCause(Box::new(source))),
                )
            }
            /// Build a request-construction error from a static message.
            pub fn request_message(message: impl Into<String>) -> Self {
