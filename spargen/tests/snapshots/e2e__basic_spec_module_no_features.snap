                            value,
                            support::Delimiter::Pipe,
                            support::PercentEncoding::Form,
                        )
                        .map_err(support::Error::request_construction)?,
                );
        }
        if let Some(value) = params.as_ref().and_then(|params| params.deep.as_ref()) {
            query
                .extend(
                    support::serialize_deep_object(
                            "deep",
                            value,
                            support::PercentEncoding::Form,
                        )
                        .map_err(support::Error::request_construction)?,
                );
        }
        if let Some(value) = params.as_ref().and_then(|params| params.reserved.as_ref())
        {
            query
                .extend(
                    support::serialize_form(
                            "reserved",
                            value,
                            true,
                            support::PercentEncoding::Reserved,
                        )
                        .map_err(support::Error::request_construction)?,
                );
        }
        let url = support::build_url_on(&self.core, None, &path, &query)
            .map_err(support::Error::widen)?;
        let mut request = self.core.http().request(reqwest::Method::GET, url);
