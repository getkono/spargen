    ///Response `204`: No Content
    #[inline]
    pub async fn upload_file(
        &self,
        body: &types::RequestBodyE12d70b5,
    ) -> Result<support::ResponseValue<()>, support::Error<UploadFileError>> {
        let mut path = "/upload".to_owned();
        let mut query: Vec<String> = Vec::new();
        let url = support::build_url_on(&self.core, None, &path, &query)
            .map_err(support::Error::widen)?;
        let mut request = self.core.http().request(reqwest::Method::POST, url);
        let mut form = reqwest::multipart::Form::new();
        let mut part = reqwest::multipart::Part::bytes(body.file.to_vec());
        part = part
            .mime_str("application/octet-stream")
            .map_err(support::Error::request_construction)?;
        form = form.part("file", part);
        let mut part = reqwest::multipart::Part::text(body.caption.to_string());
        part = part
            .mime_str("text/plain")
            .map_err(support::Error::request_construction)?;
        let mut part_headers = reqwest::header::HeaderMap::new();
        part_headers
            .insert(
                reqwest::header::HeaderName::try_from("X-Part-Kind")
                    .map_err(support::Error::request_construction)?,
                reqwest::header::HeaderValue::try_from("caption text")
                    .map_err(support::Error::request_construction)?,
            );
        part = part.headers(part_headers);
        form = form.part("caption", part);
        if let Some(value) = &body.count {
            let mut part = reqwest::multipart::Part::text(value.to_string());
            part = part
                .mime_str("text/plain")
                .map_err(support::Error::request_construction)?;
            form = form.part("count", part);
        }
        if let Some(value) = &body.tags {
            let mut part = reqwest::multipart::Part::text(
                serde_json::to_string(value)
                    .map_err(support::Error::request_construction)?,
            );
            part = part
                .mime_str("application/json")
                .map_err(support::Error::request_construction)?;
            form = form.part("tags", part);
        }
        request = request.multipart(form);
        let request = request.build().map_err(support::Error::request_construction)?;
        let response = support::send(&self.core, request)
            .await
            .map_err(support::Error::widen)?;
        if response.status().is_success() {
            let status = response.status();
            let headers = response.headers().clone();
            Ok(support::ResponseValue::new(status, headers, ()))
        } else {
            Err(
                support::unexpected_status::<UploadFileError>(&self.core, response).await,
            )
        }
    }
