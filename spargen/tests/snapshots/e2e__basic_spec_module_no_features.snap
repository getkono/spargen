                Ok((body, truncated)) => {
                    if documented.iter().any(|spec| spec.matches(status)) {
                        match serde_json::from_slice::<E>(&body) {
                            Ok(value) => {
                                Error::Api(ResponseValue::new(status, headers, value))
                            }
                            Err(error) => {
