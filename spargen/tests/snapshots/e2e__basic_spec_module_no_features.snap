            .map_err(support::Error::widen)?;
        let mut request = self.core.http().request(reqwest::Method::GET, url);
        request = request
            .header(
                "X-Text",
                support::serialize_simple(
                        &x_text,
                        false,
                        support::PercentEncoding::Passthrough,
                    )
                    .map_err(support::Error::request_construction)?,
            );
        request = request
            .header(
                "X-Json",
                serde_json::to_string(&x_json)
                    .map_err(support::Error::request_construction)?,
            );
        let request = request.build().map_err(support::Error::request_construction)?;
        let response = support::send(&self.core, request)
            .await
