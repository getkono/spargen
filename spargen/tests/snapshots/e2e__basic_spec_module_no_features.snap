            let headers = response.headers().clone();
            Ok(support::ResponseValue::new(status, headers, ()))
        } else {
            Err(
                support::unexpected_status::<
                    SerializeContentParamsError,
                >(&self.core, response)
                    .await,
            )
        }
    }
