                Framing::Ndjson => ndjson_next(buffer, at_eof),
                Framing::Sse => sse_next(buffer, at_eof, SseOutput::LegacyData),
                Framing::SseEvent => sse_next(buffer, at_eof, SseOutput::Envelope),
