                    Error::UnexpectedStatus { status, .. }
                    | Error::Decode { status, .. } => Some(*status),
                    Error::RequestConstruction(_)
                    | Error::Transport(_)
                    | Error::Timeout(_)
                    | Error::Protocol(_)
                    | Error::Redirect(_)
                    | Error::InterruptedBody(_)
                    | Error::PaginationCycle { .. } => None,
