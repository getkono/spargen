        #[derive(Debug)]
        pub struct AuthError {
            message: String,
        }
        impl AuthError {
            /// Build an authentication-provider failure from a displayable message.
            pub fn new(message: impl Into<String>) -> Self {
                Self { message: message.into() }
            }
