                        &raw,
                        false,
                        support::PercentEncoding::Unreserved,
                    )
                    .map_err(support::Error::request_construction)?,
            );
        let mut query: Vec<String> = Vec::new();
        if let Some(value) = params.as_ref().and_then(|params| params.space.as_ref()) {
            query
                .extend(
                    support::serialize_delimited(
                            "space",
                            value,
                            support::Delimiter::Space,
                            support::PercentEncoding::Form,
                        )
                        .map_err(support::Error::request_construction)?,
                );
        }
        if let Some(value) = params.as_ref().and_then(|params| params.pipe.as_ref()) {
