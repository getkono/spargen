    pub async fn serialize_content_params(
        &self,
        text: impl Into<types::Text>,
        json: types::DeepFilter,
        x_text: impl Into<types::XText>,
        x_json: types::DeepFilter,
    ) -> Result<
        support::ResponseValue<()>,
        support::Error<SerializeContentParamsError>,
    > {
        let text: types::Text = text.into();
        let x_text: types::XText = x_text.into();
        let mut path = "/content-params/{text}/{json}".to_owned();
        path = path
            .replace(
                "{text}",
                &support::encode(
                    &support::serialize_simple(
                            &text,
                            false,
                            support::PercentEncoding::Passthrough,
                        )
                        .map_err(support::Error::request_construction)?,
                    support::PercentEncoding::Unreserved,
                ),
            );
        path = path
            .replace(
                "{json}",
                &support::encode(
                    &serde_json::to_string(&json)
                        .map_err(support::Error::request_construction)?,
                    support::PercentEncoding::Unreserved,
                ),
            );
        let mut query: Vec<String> = Vec::new();
        let url = support::build_url_on(&self.core, None, &path, &query)
            .map_err(support::Error::widen)?;
        let mut request = self.core.http().request(reqwest::Method::GET, url);
        request = request
            .header(
                "X-Text",
                support::serialize_simple(
                        &x_text,
                        false,
                        support::PercentEncoding::Passthrough,
                    )
                    .map_err(support::Error::request_construction)?,
            );
        request = request
            .header(
                "X-Json",
                serde_json::to_string(&x_json)
                    .map_err(support::Error::request_construction)?,
            );
        let request = request.build().map_err(support::Error::request_construction)?;
        let response = support::send(&self.core, request)
            .await
            .map_err(support::Error::widen)?;
        if response.status().is_success() {
