                    Error::RequestConstruction(e) => Error::RequestConstruction(e),
                    Error::Transport(e) => Error::Transport(e),
                    Error::Timeout(e) => Error::Timeout(e),
                    Error::Protocol(e) => Error::Protocol(e),
                    Error::Redirect(e) => Error::Redirect(e),
