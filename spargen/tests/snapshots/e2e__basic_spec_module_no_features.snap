                HeaderShape::SetCookie => {
                    text_then_json(
                        name,
                        |scalars| {
                            Value::Array(
                                parts.iter().map(|part| scalar(part, scalars)).collect(),
                            )
                        },
                    )
                }
                HeaderShape::Json => {
                    serde_json::from_str(&raw())
                        .map_err(|error| parse_error(name, &error))
                }
                HeaderShape::Scalar => {
                    let raw = raw();
                    text_then_json(name, |scalars| scalar(&raw, scalars))
                }
                HeaderShape::Array => {
                    let raw = raw();
                    text_then_json(
                        name,
                        |scalars| {
                            Value::Array(
                                raw.split(',').map(|part| scalar(part, scalars)).collect(),
                            )
                        },
                    )
                }
                HeaderShape::Object => {
                    let raw = raw();
                    text_then_json(name, |scalars| object(&raw, explode, scalars))
                }
            }
                .map(Some)
        }
        /// Deserialize the value `build` rebuilds from header text, reading every token as text first.
        ///
        /// `simple` is plain text, so a token like `1` is ambiguous between the string "1" and the number
        /// 1 — the encoding cannot tell them apart. The target type can: the text-only reading is tried
        /// first, and the JSON reading only if that does not deserialize. The error reported is the
        /// JSON-flavored one, which is the more informative of the two.
        fn text_then_json<T: DeserializeOwned>(
            name: &'static str,
            build: impl Fn(Scalars) -> Value,
        ) -> Result<T, HeaderError> {
            if let Ok(value) = serde_json::from_value(build(Scalars::Text)) {
                return Ok(value);
            }
            serde_json::from_value(build(Scalars::Json))
                .map_err(|error| parse_error(name, &error))
        }
        /// The [`HeaderError::Parse`] for header `name`, carrying serde's message.
        fn parse_error(name: &'static str, error: &serde_json::Error) -> HeaderError {
            HeaderError::Parse {
                name,
                message: error.to_string(),
            }
        }
        /// How a bare header token is interpreted when rebuilding a JSON value.
        #[derive(Debug, Clone, Copy, PartialEq, Eq)]
        enum Scalars {
            /// Every token is a string.
            Text,
            /// A token that reads as a JSON number, boolean, or null takes that type.
            Json,
        }
        /// As [`parse_header`], but an absent header is [`HeaderError::Missing`].
        pub fn require_header<T: DeserializeOwned>(
            headers: &HeaderMap,
            name: &'static str,
            shape: HeaderShape,
            explode: bool,
        ) -> Result<T, HeaderError> {
            parse_header(headers, name, shape, explode)?
                .ok_or(HeaderError::Missing { name })
        }
        /// Rebuild a JSON object from `simple`-style header text: `key=value` members when `explode` is
        /// set, alternating `key,value` tokens otherwise.
        fn object(raw: &str, explode: bool, scalars: Scalars) -> Value {
            let mut members = serde_json::Map::new();
            if explode {
                for pair in raw.split(',') {
                    if let Some((key, value)) = pair.split_once('=') {
                        members.insert(key.to_owned(), scalar(value, scalars));
                    }
                }
            } else {
                let parts: Vec<&str> = raw.split(',').collect();
                for pair in parts.chunks(2) {
                    if let [key, value] = pair {
                        members.insert((*key).to_owned(), scalar(value, scalars));
                    }
                }
            }
            Value::Object(members)
        }
        /// Interpret one header token.
        fn scalar(raw: &str, scalars: Scalars) -> Value {
            if scalars == Scalars::Text {
                return Value::String(raw.to_owned());
            }
            match serde_json::from_str::<Value>(raw) {
                Ok(Value::Number(number)) if number.is_f64() => {
                    Value::Number(exact_float(raw, number))
                }
                Ok(value @ (Value::Number(_) | Value::Bool(_) | Value::Null)) => value,
                _ => Value::String(raw.to_owned()),
            }
        }
        /// The float `raw` spells, correctly rounded, in place of `parsed`, `serde_json`'s reading of it.
        ///
        /// Without its `float_roundtrip` feature `serde_json` may read a float's text as a neighbouring
        /// value, so a finite `f64` written by [`super::parameter::serialize_simple`] would not come back
        /// as itself. The standard library's parser rounds correctly, and accepts every JSON number, which
        /// `serde_json` has already checked `raw` is. A token that rounds out of the finite range keeps
        /// `parsed`, since a JSON number cannot hold an infinity.
        fn exact_float(raw: &str, parsed: serde_json::Number) -> serde_json::Number {
            raw.trim_matches([' ', '\t', '\n', '\r'])
                .parse::<f64>()
                .ok()
                .and_then(serde_json::Number::from_f64)
                .unwrap_or(parsed)
        }
    }
    mod middleware {
        //! Interceptor middleware for the transport seam: [`MiddlewareBackend`] wraps any inner
        //! [`HttpBackend`] with an ordered chain of [`Middleware`] that can observe/modify a request before
        //! it is sent and the response after, short-circuit before the transport runs, and do async work
        //! around the call.
        //!
        //! ## The `Next` continuation (tower-like, no dependencies)
        //!
        //! A middleware receives the request plus a [`Next`] handle. Calling [`Next::run`] advances to the
        //! rest of the chain — the next middleware, or, when the chain is exhausted, the inner
        //! [`HttpBackend`]. A middleware may inspect/modify the request before calling `run`, inspect the
        //! [`http::Response`] after, or return a response *without* calling `run` at all to
        //! short-circuit. This is
        //! the classic "onion" middleware shape, expressed with std's `Future`/`Pin`/`Box` — no
        //! `async-trait` and no `tower`, so middleware adds no dependency to the generated runtime.
        //!
        //! ### How the lifetimes work without `async-trait`
        //!
        //! [`Middleware::handle`] is `handle<'a>(&'a self, request, next: Next<'a>) -> …Future… + 'a`: the
        //! `'a` ties the borrow of the middleware, the [`Next`] it is handed, and the boxed future it
        //! returns to a single lifetime. [`Next<'a>`] holds only borrows — `&'a [Arc<dyn Middleware>]` for
        //! the remaining chain and `&'a Arc<dyn HttpBackend>` for the inner transport — so advancing the
        //! chain never clones or reallocates; it just narrows the slice. [`MiddlewareBackend::execute`]
        //! returns [`ExecuteFuture<'_>`], whose `'_` is exactly the borrow of `&self` the [`Next`] is built
        //! over, so the whole chain's future safely borrows the (Arc-held) middleware and backend for the
        //! duration of the call. The `Send` bounds on those borrows and futures follow the target, as the
        //! `wasm` module explains.
        //!
        //! ## Ordering
        //!
        //! The first middleware in the vector runs **outermost**: it sees the request first and the response
        //! last. The last middleware runs innermost, closest to the transport. So
        //! `MiddlewareBackend::new(inner).layer(a).layer(b)` runs `a` around `b` around `inner`.
        //!
        //! ## Composability
        //!
        //! [`MiddlewareBackend`] wraps *any* [`HttpBackend`], so it composes freely with the retry adapter
        //! ([`super::RetryBackend`]) and the default [`super::ReqwestBackend`] in either order. Wrapping a
        //! `RetryBackend` in a `MiddlewareBackend` runs the middleware **once** around the whole retry loop;
        //! wrapping a `MiddlewareBackend` in a `RetryBackend` re-runs the middleware **per attempt**. Pick
        //! the nesting that matches whether an interceptor should observe each attempt or just the final
        //! outcome.
        //!
        //! ```ignore
        //! use std::sync::Arc;
        //!
        //! let inner: Arc<dyn HttpBackend> = Arc::new(ReqwestBackend::new(reqwest::Client::new()));
        //! let backend: Arc<dyn HttpBackend> = Arc::new(
        //!     MiddlewareBackend::new(inner).layer(Arc::new(MyLogger)),
        //! );
        //! let client = Client::with_backend(backend, "https://api.example.com")?;
        //! ```
        use std::sync::Arc;
        use super::transport::{ExecuteFuture, HttpBackend};
        use super::{HttpBody, MaybeSend, MaybeSync};
        /// A request as the transport seam carries it.
        type Request = http::Request<HttpBody>;
        /// One link in the interceptor chain: it observes/modifies a request on the way in, calls
        /// [`Next::run`] to proceed (eventually reaching the transport), and observes/modifies the
        /// [`http::Response`] on the way out — or returns early to short-circuit.
        ///
        /// Implementations must be [`MaybeSend`] + [`MaybeSync`] — `Send + Sync` on native (the `Client` is
        /// shared across tasks), vacuous on `wasm32` — and `Debug` (so [`MiddlewareBackend`] — and thus
        /// [`super::ClientCore`] — stays `Debug`). The returned future is manually boxed so the trait is
        /// object-safe without an `async-trait` dependency.
        pub trait Middleware: MaybeSend + MaybeSync + std::fmt::Debug {
            /// Handle a request. Call `next.run(request)` to proceed to the rest of the chain (eventually
            /// the transport), or return a response without calling it to short-circuit. May inspect/modify
            /// the request before and the [`http::Response`] after.
            fn handle<'a>(
                &'a self,
                request: Request,
                next: Next<'a>,
            ) -> ExecuteFuture<'a>;
        }
        /// The continuation handed to a [`Middleware`]: it represents "the rest of the chain" — the
        /// remaining middlewares followed by the inner transport.
        ///
        /// Holds only borrows (`'a`) into the [`MiddlewareBackend`], so advancing the chain is allocation-
        /// free. Call [`Next::run`] to proceed; dropping a `Next` without calling `run` is how a middleware
        /// short-circuits.
        pub struct Next<'a> {
            /// The middlewares that still have to run, in order; the first is the next to run.
            remaining: &'a [Arc<dyn Middleware>],
            /// The transport reached once `remaining` is empty.
            inner: &'a Arc<dyn HttpBackend>,
        }
        impl<'a> Next<'a> {
            /// Proceed to the rest of the chain: run the next middleware, or — when no middlewares remain —
            /// execute the request on the inner transport. Returns the eventual [`http::Response`] or the
            /// [`super::TransportError`] the transport failed with.
            pub fn run(self, request: Request) -> ExecuteFuture<'a> {
                match self.remaining.split_first() {
                    Some((first, rest)) => {
                        first
                            .handle(
                                request,
                                Next {
                                    remaining: rest,
                                    inner: self.inner,
                                },
                            )
                    }
                    None => self.inner.execute(request),
                }
            }
        }
        /// An [`HttpBackend`] that runs an ordered chain of [`Middleware`] around an inner backend.
        ///
        /// The first middleware in the chain runs outermost (see this module's docs for ordering and
        /// composability). It takes effect only when a caller wraps their backend in it and installs it via
        /// `Client::with_backend`.
        #[derive(Clone, Debug)]
        pub struct MiddlewareBackend {
            inner: Arc<dyn HttpBackend>,
            middlewares: Vec<Arc<dyn Middleware>>,
        }
        impl MiddlewareBackend {
            /// Start a chain around `inner` with no middlewares; add them with [`Self::layer`].
            pub fn new(inner: Arc<dyn HttpBackend>) -> Self {
                Self {
                    inner,
                    middlewares: Vec::new(),
                }
            }
            /// Wrap `inner` with a pre-built ordered list of middlewares (index 0 runs outermost).
            pub fn with_middlewares(
                inner: Arc<dyn HttpBackend>,
                middlewares: Vec<Arc<dyn Middleware>>,
            ) -> Self {
                Self { inner, middlewares }
            }
            /// Append a middleware to the chain and return `self`, for builder-style construction. Each
            /// appended middleware runs *inside* the ones added before it (the first added is outermost).
            #[must_use]
            pub fn layer(mut self, middleware: Arc<dyn Middleware>) -> Self {
                self.middlewares.push(middleware);
                self
            }
            /// The wrapped inner backend.
            pub fn inner(&self) -> &Arc<dyn HttpBackend> {
                &self.inner
            }
            /// The middleware chain, in run order (index 0 is outermost).
            pub fn middlewares(&self) -> &[Arc<dyn Middleware>] {
                &self.middlewares
            }
        }
        impl HttpBackend for MiddlewareBackend {
            fn execute(&self, request: Request) -> ExecuteFuture<'_> {
                Next {
                    remaining: &self.middlewares,
                    inner: &self.inner,
                }
                    .run(request)
            }
        }
    }
    mod parameter {
        //! OpenAPI parameter serialization for every style the specification defines.
        //!
        //! Generated methods keep parameter values typed until request construction. These helpers use
        //! `serde` only as an inspection bridge, then apply the OpenAPI delimiter, `explode`, and
        //! percent-encoding rules; they never rely on a generated model implementing [`std::fmt::Display`].
        //!
        //! The governing invariant is that **delimiters are emitted literally and every data byte is
        //! percent-encoded**. That is what makes a `,` that joins two array items distinguishable from a
        //! `,` inside one of the values — OpenAPI requires exactly this, and it is why query fragments are
        //! assembled here rather than through `url`'s `query_pairs_mut`, which would encode both alike.
        use std::fmt;
        use std::fmt::Write as _;
        use serde::Serialize;
        use serde_json::{Map, Value};
        /// Which characters survive unencoded when a serialized value is placed on the wire.
        ///
        /// The variant is chosen by codegen from the parameter's location, style, and `allowReserved`;
        /// the mapping lives in exactly one place in the generator so the rule cannot drift.
        #[derive(Debug, Clone, Copy, PartialEq, Eq)]
        pub enum PercentEncoding {
            /// Encode every byte outside RFC 3986 `unreserved` (`A-Za-z0-9` and `-._~`). Used for path
            /// values with `allowReserved: false`; guarantees no unescaped `/`, `?`, or `#` can reach the
            /// path and silently re-route the request.
            Unreserved,
            /// As [`Unreserved`](Self::Unreserved) but also encodes `~`, matching the `form-urlencoded`
            /// safe set. Used for query and `style: form` cookie values. A space is always `%20`, never
            /// `+`.
            Form,
            /// RFC 6570 reserved expansion for a query value (`allowReserved: true`): RFC 3986 reserved
            /// characters and well-formed percent-triples pass through, except `#`, `[`, `]`, `&`, `=`,
            /// and `+`, which would break the query string or the `form-urlencoded` pair syntax. A `%`
            /// that does not begin a valid triple is encoded.
            Reserved,
            /// Reserved expansion for a *path* value: as [`Reserved`](Self::Reserved), but `&`, `=`, `+`,
            /// `[`, and `]` pass through while `/`, `?`, and `#` are still encoded — the specification
            /// forbids those unescaped in a path regardless of `allowReserved`.
            ReservedPath,
            /// Pass the value through byte-for-byte. Used for headers, `style: cookie`, and every
            /// `multipart/form-data` value, all of which the specification says must not be percent-encoded.
            Passthrough,
        }
        /// The delimiter of the non-RFC 6570 query styles. Always emitted percent-encoded, because an
        /// unencoded space or `|` is not legal in a query string.
        #[derive(Debug, Clone, Copy, PartialEq, Eq)]
        pub enum Delimiter {
            /// `style: spaceDelimited` — `%20`.
            Space,
            /// `style: pipeDelimited` — `%7C`.
            Pipe,
        }
        impl Delimiter {
            /// The already-encoded delimiter text.
            pub fn as_str(self) -> &'static str {
                match self {
                    Self::Space => "%20",
                    Self::Pipe => "%7C",
                }
            }
        }
        /// A typed parameter could not be represented by OpenAPI's scalar/array/object wire model.
        #[derive(Debug)]
        pub enum ParameterError {
            /// Serialization of the generated Rust value failed.
            Serialize(serde_json::Error),
            /// A nested array or object appeared where OpenAPI parameter serialization requires a scalar.
            NestedValue,
            /// A `style: deepObject` query parameter's value was not an object
            /// ([`serialize_deep_object`]).
            ExpectedObject,
            /// A form-urlencoded request body did not serialize to a JSON object
            /// ([`serialize_form_body`]).
            FormBodyNotObject,
            /// A multipart part was asked for the query-only `deepObject` style
            /// ([`serialize_multipart_values`]).
            DeepObjectInMultipart,
            /// A style defined only for arrays and objects (`spaceDelimited`, `pipeDelimited`) received a
            /// scalar or undefined value.
            ExpectedComposite,
        }
        impl fmt::Display for ParameterError {
            fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
                match self {
                    Self::Serialize(error) => {
                        write!(formatter, "parameter serialization failed: {error}")
                    }
                    Self::NestedValue => {
                        formatter
                            .write_str(
                                "nested arrays and objects are not supported by OpenAPI parameter serialization",
                            )
                    }
                    Self::ExpectedObject => {
                        formatter
                            .write_str(
                                "`style: deepObject` requires an object parameter value",
                            )
                    }
                    Self::FormBodyNotObject => {
                        formatter
                            .write_str(
                                "an `application/x-www-form-urlencoded` request body requires an object value",
                            )
                    }
                    Self::DeepObjectInMultipart => {
                        formatter
                            .write_str(
                                "`style: deepObject` is defined only for query parameters, not multipart part values",
                            )
                    }
                    Self::ExpectedComposite => {
                        formatter
                            .write_str(
                                "`style: spaceDelimited` and `style: pipeDelimited` require an array or object \
                 parameter value",
                            )
                    }
                }
            }
        }
        impl std::error::Error for ParameterError {
            fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
                match self {
                    Self::Serialize(error) => Some(error),
                    Self::NestedValue
                    | Self::ExpectedObject
                    | Self::FormBodyNotObject
                    | Self::DeepObjectInMultipart
                    | Self::ExpectedComposite => None,
                }
            }
        }
        impl From<serde_json::Error> for ParameterError {
            fn from(error: serde_json::Error) -> Self {
                Self::Serialize(error)
            }
        }
        /// Percent-encode `value` under `encoding`.
        ///
        /// Encoding operates on UTF-8 bytes, so one multi-byte character yields one triple per byte.
        pub fn encode(value: &str, encoding: PercentEncoding) -> String {
            let mut out = String::with_capacity(value.len());
            encode_into(&mut out, value, encoding);
            out
        }
        /// As [`encode`], appending to `out` instead of returning a new string.
        fn encode_into(out: &mut String, value: &str, encoding: PercentEncoding) {
            if encoding == PercentEncoding::Passthrough {
                out.push_str(value);
                return;
            }
            let bytes = value.as_bytes();
            let mut index = 0;
            while index < bytes.len() {
                let byte = bytes[index];
                if byte == b'%'
                    && matches!(
                        encoding, PercentEncoding::Reserved |
                        PercentEncoding::ReservedPath
                    ) && index + 2 < bytes.len() && bytes[index + 1].is_ascii_hexdigit()
                    && bytes[index + 2].is_ascii_hexdigit()
                {
                    out.push('%');
                    out.push(bytes[index + 1] as char);
                    out.push(bytes[index + 2] as char);
                    index += 3;
                    continue;
                }
                if keeps(byte, encoding) {
                    out.push(byte as char);
                } else {
                    out.push('%');
                    out.push(upper_hex(byte >> 4));
                    out.push(upper_hex(byte & 0x0f));
                }
                index += 1;
            }
        }
        /// Whether `byte` is emitted literally under `encoding`.
        fn keeps(byte: u8, encoding: PercentEncoding) -> bool {
            let unreserved = byte.is_ascii_alphanumeric()
                || matches!(byte, b'-' | b'.' | b'_' | b'~');
            match encoding {
                PercentEncoding::Passthrough => true,
                PercentEncoding::Unreserved => unreserved,
                PercentEncoding::Form => unreserved && byte != b'~',
                PercentEncoding::Reserved => {
                    unreserved
                        || matches!(
                            byte, b':' | b'/' | b'?' | b'@' | b'!' | b'$' | b'\'' | b'('
                            | b')' | b'*' | b',' | b';'
                        )
                }
                PercentEncoding::ReservedPath => {
                    unreserved
                        || matches!(
                            byte, b':' | b'@' | b'!' | b'$' | b'\'' | b'(' | b')' | b'*'
                            | b',' | b';' | b'&' | b'=' | b'+' | b'[' | b']'
                        )
                }
            }
        }
        fn upper_hex(nibble: u8) -> char {
            match nibble {
                0..=9 => (b'0' + nibble) as char,
                _ => (b'A' + (nibble - 10)) as char,
            }
        }
        /// Serialize one `style: simple` value for a path or header parameter.
        ///
        /// Scalars render directly, arrays are comma-separated, and objects alternate keys and values
        /// unless `explode` is true, in which case each member is rendered as `key=value`.
        pub fn serialize_simple<T: Serialize>(
            value: &T,
            explode: bool,
            encoding: PercentEncoding,
        ) -> Result<String, ParameterError> {
            match serde_json::to_value(value)? {
                Value::Null => Ok(String::new()),
                Value::Array(values) => join_scalars(values.iter(), ",", encoding),
                Value::Object(values) if explode => {
                    Ok(object_pairs(&values, encoding)?.join(","))
                }
                Value::Object(values) => object_flat(&values, ",", encoding),
                value => scalar(&value, encoding),
            }
        }
        /// Serialize one `style: matrix` path parameter, including its leading `;` and — where the
        /// serialization rules keep it — the parameter name. An empty array or object is undefined
        /// (RFC 6570 §2.3), like `null`: it renders as `;name` under either `explode`.
        pub fn serialize_matrix<T: Serialize>(
            name: &str,
            value: &T,
            explode: bool,
            encoding: PercentEncoding,
        ) -> Result<String, ParameterError> {
            let name = encode(name, encoding);
            match empty_as_undefined(serde_json::to_value(value)?) {
                Value::Null => Ok(format!(";{name}")),
                Value::Array(values) if explode => {
                    values
                        .iter()
                        .map(|value| Ok(
                            format!(";{name}={}", scalar(value, encoding) ?),
                        ))
                        .collect::<Result<Vec<_>, ParameterError>>()
                        .map(|parts| parts.concat())
                }
                Value::Array(values) => {
                    Ok(
                        format!(
                            ";{name}={}", join_scalars(values.iter(), ",", encoding) ?
                        ),
                    )
                }
                Value::Object(values) if explode => {
                    Ok(
                        object_pairs(&values, encoding)?
                            .iter()
                            .map(|pair| format!(";{pair}"))
                            .collect(),
                    )
                }
                Value::Object(values) => {
                    Ok(format!(";{name}={}", object_flat(& values, ",", encoding) ?))
                }
                value => Ok(format!(";{name}={}", scalar(& value, encoding) ?)),
            }
        }
        /// Serialize one `style: label` path parameter, including its leading `.`.
        ///
        /// A serialization that is exactly `.` or `..` is returned as it is. Where it forms a whole path
        /// segment, `Url::set_path` would remove it in any spelling (`%2E` included), so the URL builder
        /// refuses that path rather than let it re-target the request.
        pub fn serialize_label<T: Serialize>(
            value: &T,
            explode: bool,
            encoding: PercentEncoding,
        ) -> Result<String, ParameterError> {
            let rendered = match serde_json::to_value(value)? {
                Value::Null => String::new(),
                Value::Array(values) if explode => {
                    join_scalars(values.iter(), ".", encoding)?
                }
                Value::Array(values) => join_scalars(values.iter(), ",", encoding)?,
                Value::Object(values) if explode => {
                    object_pairs(&values, encoding)?.join(".")
                }
                Value::Object(values) => object_flat(&values, ",", encoding)?,
                value => scalar(&value, encoding)?,
            };
            Ok(format!(".{rendered}"))
        }
        /// Serialize one `style: form` value into fully-encoded `name=value` query or cookie fragments.
        ///
        /// With `explode: true`, arrays repeat the parameter name and objects use each property name.
        /// With `explode: false`, either shape is flattened into one comma-separated value under `name`.
        /// An empty array or object is undefined (RFC 6570 §2.3), like `null`: it renders as `name=`
        /// under either `explode`. An empty `name` is a form-encoded `in: querystring` value, the whole
        /// query rather than one parameter, so an empty composite there has no name to keep and renders
        /// no fragment.
        /// `style: cookie` is exactly this function with [`PercentEncoding::Passthrough`] — the two rows
        /// of the specification's serialization table are otherwise identical.
        pub fn serialize_form<T: Serialize>(
            name: &str,
            value: &T,
            explode: bool,
            encoding: PercentEncoding,
        ) -> Result<Vec<String>, ParameterError> {
            let value = serde_json::to_value(value)?;
            let value = if name.is_empty() { value } else { empty_as_undefined(value) };
            let name = encode(name, encoding);
            match value {
                Value::Null => Ok(vec![format!("{name}=")]),
                Value::Array(values) if explode => {
                    values
                        .iter()
                        .map(|value| Ok(format!("{name}={}", scalar(value, encoding) ?)))
                        .collect()
                }
                Value::Array(values) => {
                    Ok(
                        vec![
                            format!("{name}={}", join_scalars(values.iter(), ",",
                            encoding) ?)
                        ],
                    )
                }
                Value::Object(values) if explode => object_pairs(&values, encoding),
                Value::Object(values) => {
                    Ok(
                        vec![
                            format!("{name}={}", object_flat(& values, ",", encoding) ?)
                        ],
                    )
                }
                value => Ok(vec![format!("{name}={}", scalar(& value, encoding) ?)]),
            }
        }
        /// Serialize one `style: spaceDelimited` or `style: pipeDelimited` query parameter.
        ///
        /// Both styles are defined only for arrays and objects with `explode: false`, and any other value
        /// is refused with `ParameterError::ExpectedComposite`. Generation rejects `explode: true` and a
        /// schema that admits a scalar, or `null` on a required parameter, so a generated call never
        /// receives that error.
        pub fn serialize_delimited<T: Serialize>(
            name: &str,
            value: &T,
            delimiter: Delimiter,
            encoding: PercentEncoding,
        ) -> Result<Vec<String>, ParameterError> {
            let name = encode(name, encoding);
            match serde_json::to_value(value)? {
                Value::Array(values) => {
                    Ok(
                        vec![
                            format!("{name}={}", join_scalars(values.iter(), delimiter
                            .as_str(), encoding) ?)
                        ],
                    )
                }
                Value::Object(values) => {
                    Ok(
                        vec![
                            format!("{name}={}", object_flat(& values, delimiter
                            .as_str(), encoding) ?)
                        ],
                    )
                }
                _ => Err(ParameterError::ExpectedComposite),
            }
        }
        /// Serialize one `style: deepObject` query parameter into `name[key]=value` fragments.
        ///
        /// `explode` has no effect on this style. The `[`/`]` are emitted as the literal delimiters
        /// `%5B`/`%5D`; a bracket inside a property key encodes to the same triple, an ambiguity the
        /// specification itself acknowledges as inherent to the style.
        ///
        /// The style is defined only for objects, and any other value is refused with
        /// `ParameterError::ExpectedObject`. Generation rejects a schema that admits a non-object, or
        /// `null` on a required parameter, so a generated call never receives that error.
        pub fn serialize_deep_object<T: Serialize>(
            name: &str,
            value: &T,
            encoding: PercentEncoding,
        ) -> Result<Vec<String>, ParameterError> {
            let name = encode(name, encoding);
            match serde_json::to_value(value)? {
                Value::Object(values) => {
                    values
                        .iter()
                        .map(|(key, value)| {
                            Ok(
                                format!(
                                    "{name}%5B{}%5D={}", encode(key, encoding), scalar(value,
                                    encoding) ?
                                ),
                            )
                        })
                        .collect()
                }
                _ => Err(ParameterError::ExpectedObject),
            }
        }
        /// The resolved wire encoding of one property of a form or multipart request body.
        ///
        /// Codegen emits these as a `&'static [FormProperty]` const, fully resolved — the Encoding
        /// Object's defaulting rules run at generation time, so the runtime never has to infer anything.
        #[derive(Debug, Clone, Copy)]
        pub struct FormProperty {
            /// The wire property name: the form field name, or the multipart part name.
            pub name: &'static str,
            /// How the value is rendered.
            pub mode: FormMode,
        }
        /// How one form or multipart property is rendered.
        #[derive(Debug, Clone, Copy)]
        pub enum FormMode {
            /// The scalar rendered as-is.
            Text,
            /// The value rendered as JSON.
            Json,
            /// RFC 6570 query-style serialization.
            Style {
                /// The form style in use.
                style: FormStyle,
                explode: bool,
                encoding: PercentEncoding,
            },
        }
        /// The subset of parameter styles an Encoding Object may select.
        #[derive(Debug, Clone, Copy, PartialEq, Eq)]
        pub enum FormStyle {
            /// `style: form`.
            Form,
            /// `style: spaceDelimited` / `pipeDelimited`.
            Delimited(Delimiter),
            /// `style: deepObject`.
            DeepObject,
        }
        /// Serialize a whole `application/x-www-form-urlencoded` request body.
        ///
        /// `value` must serialize to a JSON object. Each property is rendered by its own resolved
        /// `FormProperty`, in the order codegen emitted them, so output is deterministic. A property whose
        /// value is JSON `null` is omitted entirely rather than sent empty.
        ///
        /// `additional` is the body's typed `additionalProperties` overflow: the resolved mode of its
        /// members (the default for their type, since no Encoding Object can name them) and how many
        /// members the overflow map holds, which a generated struct serializes after its declared fields.
        /// When it is `Some`, those members follow the declared ones, ordered by key, rendered in that
        /// mode; when it is `None`, members `properties` does not name are not sent. An overflow member
        /// whose key repeats a declared property's name is never sent: the declared property's own value
        /// is, or nothing when that property is absent, as in a multipart body.
        ///
        /// A `value` that does not serialize to a JSON object is refused with
        /// `ParameterError::FormBodyNotObject`.
        pub fn serialize_form_body<T: Serialize>(
            value: &T,
            properties: &[FormProperty],
            additional: Option<(FormMode, usize)>,
        ) -> Result<String, ParameterError> {
            let text = serde_json::to_vec(value)?;
            if text.first() != Some(&b'{') {
                return Err(ParameterError::FormBodyNotObject);
            }
            let OrderedMembers(members) = serde_json::from_slice(&text)?;
            let overflow_len = additional.map_or(0, |(_, len)| len);
            let (declared, overflow) = members
                .split_at(members.len().saturating_sub(overflow_len));
            let mut fragments: Vec<String> = Vec::new();
            for property in properties {
                if let Some((_, member)) = declared
                    .iter()
                    .find(|(name, _)| name == property.name)
                {
                    push_form_member(
                        &mut fragments,
                        property.name,
                        member,
                        property.mode,
                    )?;
                }
            }
            if let Some((mode, _)) = additional {
                for (name, member) in overflow {
                    if !properties.iter().any(|property| property.name == name) {
                        push_form_member(&mut fragments, name, member, mode)?;
                    }
                }
            }
            Ok(fragments.join("&"))
        }
        /// A JSON object's members in the order they were written, a repeated key kept each time it
        /// appears.
        struct OrderedMembers(Vec<(String, Value)>);
        impl<'de> serde::Deserialize<'de> for OrderedMembers {
            fn deserialize<D: serde::Deserializer<'de>>(
                deserializer: D,
            ) -> Result<Self, D::Error> {
                struct MembersVisitor;
                impl<'de> serde::de::Visitor<'de> for MembersVisitor {
                    type Value = OrderedMembers;
                    fn expecting(
                        &self,
                        formatter: &mut fmt::Formatter<'_>,
                    ) -> fmt::Result {
                        formatter.write_str("a JSON object")
                    }
                    fn visit_map<A: serde::de::MapAccess<'de>>(
                        self,
                        mut map: A,
                    ) -> Result<OrderedMembers, A::Error> {
                        let mut members = Vec::new();
                        while let Some(member) = map.next_entry::<String, Value>()? {
                            members.push(member);
                        }
                        Ok(OrderedMembers(members))
                    }
                }
                deserializer.deserialize_map(MembersVisitor)
            }
        }
        /// Render one member of a form body in `mode`; a JSON `null` member adds nothing.
        fn push_form_member(
            fragments: &mut Vec<String>,
            name: &str,
            member: &Value,
            mode: FormMode,
        ) -> Result<(), ParameterError> {
            if member.is_null() {
                return Ok(());
            }
            match mode {
                FormMode::Text => {
                    fragments
                        .push(
                            format!(
                                "{}={}", encode(name, PercentEncoding::Form), scalar(member,
                                PercentEncoding::Form) ?
                            ),
                        )
                }
                FormMode::Json => {
                    fragments
                        .push(
                            format!(
                                "{}={}", encode(name, PercentEncoding::Form), encode(&
                                serde_json::to_string(member) ?, PercentEncoding::Form)
                            ),
                        )
                }
                FormMode::Style { style, explode, encoding } => {
                    fragments
                        .extend(style_fragments(name, member, style, explode, encoding)?)
                }
            }
            Ok(())
        }
        /// The per-part values for one RFC 6570-mode `multipart/form-data` property.
        ///
        /// An array yields one value per item when `explode` is set, all sent under the same part name (the
        /// RFC 7578 §4.3 shape the specification points at); otherwise the items are joined by the
        /// style's delimiter into a single value. Any other shape yields one value.
        ///
        /// Two rules make this deliberately *not* the query-fragment builders with the `name=` prefix
        /// stripped:
        ///
        /// - The part name travels in `Content-Disposition`, so no fragment syntax appears in the value.
        /// - "When using RFC6570-style serialization for `multipart/form-data`, URI percent-encoding MUST
        ///   NOT be applied" — so the delimiters are emitted literally (` `, `|`, `,`), not as the `%20` /
        ///   `%7C` triples a query string needs, and the data is passed through byte-for-byte.
        ///
        /// Object values never reach here: the specification defines no part representation for them, so
        /// the frontend rejects an object-valued RFC 6570 encoding (and `deepObject`, which is a query-only
        /// style) rather than guessing at one. A `deepObject` `style` is refused with
        /// `ParameterError::DeepObjectInMultipart`.
        pub fn serialize_multipart_values<T: Serialize>(
            value: &T,
            style: FormStyle,
            explode: bool,
        ) -> Result<Vec<String>, ParameterError> {
            let raw = PercentEncoding::Passthrough;
            let separator = match style {
                FormStyle::Form => ",",
                FormStyle::Delimited(Delimiter::Space) => " ",
                FormStyle::Delimited(Delimiter::Pipe) => "|",
                FormStyle::DeepObject => {
                    return Err(ParameterError::DeepObjectInMultipart);
                }
            };
            match serde_json::to_value(value)? {
                Value::Null => Ok(vec![String::new()]),
                Value::Array(values) if explode => {
                    values
                        .iter()
                        .map(|value| scalar(value, raw))
                        .collect::<Result<Vec<_>, ParameterError>>()
                }
                Value::Array(values) => {
                    Ok(vec![join_scalars(values.iter(), separator, raw) ?])
                }
                Value::Object(_) => Err(ParameterError::NestedValue),
                value => Ok(vec![scalar(& value, raw) ?]),
            }
        }
        fn style_fragments(
            name: &str,
            value: &Value,
            style: FormStyle,
            explode: bool,
            encoding: PercentEncoding,
        ) -> Result<Vec<String>, ParameterError> {
            match style {
                FormStyle::Form => serialize_form(name, value, explode, encoding),
                FormStyle::Delimited(delimiter) => {
                    serialize_delimited(name, value, delimiter, encoding)
                }
                FormStyle::DeepObject => serialize_deep_object(name, value, encoding),
            }
        }
        /// `value`, with an empty array or object replaced by `null`: RFC 6570 §2.3 counts an empty list
        /// or associative array as undefined, and the specification's style table renders an undefined
        /// value as `;name` under `matrix` and `name=` under `form`, whichever `explode` is.
        fn empty_as_undefined(value: Value) -> Value {
            match value {
                Value::Array(ref values) if values.is_empty() => Value::Null,
                Value::Object(ref values) if values.is_empty() => Value::Null,
                value => value,
            }
        }
        /// The scalars `values` yields, each rendered under `encoding`, `separator`-joined into one
        /// string. Every item is written straight into that one buffer, which starts with room for the
        /// unencoded rendering, so a value that needs no escaping is joined in a single allocation.
        fn join_scalars<'a>(
            values: impl Iterator<Item = &'a Value> + Clone,
            separator: &str,
            encoding: PercentEncoding,
        ) -> Result<String, ParameterError> {
            let capacity = values
                .clone()
                .map(|value| scalar_len_hint(value) + separator.len())
                .sum::<usize>();
            let mut out = String::with_capacity(capacity);
            for (index, value) in values.enumerate() {
                if index > 0 {
                    out.push_str(separator);
                }
                push_scalar(&mut out, value, encoding)?;
            }
            Ok(out)
        }
        /// An object's members as `key,value` alternating in one `separator`-joined value: the
        /// `explode: false` shape every style but `deepObject` shares. As [`join_scalars`], the members
        /// are written into one buffer sized for their unencoded rendering.
        fn object_flat(
            values: &Map<String, Value>,
            separator: &str,
            encoding: PercentEncoding,
        ) -> Result<String, ParameterError> {
            let capacity = values
                .iter()
                .map(|(key, value)| {
                    key.len() + scalar_len_hint(value) + 2 * separator.len()
                })
                .sum::<usize>();
            let mut out = String::with_capacity(capacity);
            for (index, (key, value)) in values.iter().enumerate() {
                if index > 0 {
                    out.push_str(separator);
                }
                encode_into(&mut out, key, encoding);
                out.push_str(separator);
                push_scalar(&mut out, value, encoding)?;
            }
            Ok(out)
        }
        /// An object's members as one `key=value` fragment each: the `explode: true` shape, which each
        /// style then prefixes or joins.
        fn object_pairs(
            values: &Map<String, Value>,
            encoding: PercentEncoding,
        ) -> Result<Vec<String>, ParameterError> {
            values
                .iter()
                .map(|(key, value)| {
                    Ok(
                        format!(
                            "{}={}", encode(key, encoding), scalar(value, encoding) ?
                        ),
                    )
                })
                .collect()
        }
        fn scalar(
            value: &Value,
            encoding: PercentEncoding,
        ) -> Result<String, ParameterError> {
            let mut out = String::with_capacity(scalar_len_hint(value));
            push_scalar(&mut out, value, encoding)?;
            Ok(out)
        }
        /// Append the rendering of one scalar `value` to `out`.
        fn push_scalar(
            out: &mut String,
            value: &Value,
            encoding: PercentEncoding,
        ) -> Result<(), ParameterError> {
            match value {
                Value::Null => {}
                Value::Bool(value) => out.push_str(if *value { "true" } else { "false" }),
                Value::Number(value) => {
                    let _ = write!(out, "{value}");
                }
                Value::String(value) => encode_into(out, value, encoding),
                Value::Array(_) | Value::Object(_) => {
                    return Err(ParameterError::NestedValue);
                }
            }
            Ok(())
        }
        /// The length of `value`'s rendering before percent-encoding, which can only lengthen it: the
        /// capacity a buffer starts with so a value that needs no escaping fills it without growing.
        fn scalar_len_hint(value: &Value) -> usize {
            match value {
                Value::Null | Value::Array(_) | Value::Object(_) => 0,
                Value::Bool(_) => "false".len(),
                Value::Number(_) => 24,
                Value::String(value) => value.len(),
            }
        }
    }
    mod paginate {
        //! Generic, freestanding pagination helpers usable with any operation.
        //!
        //! OpenAPI has no standard machine-readable pagination declaration, so per-operation
        //! auto-paginators cannot be synthesised from a spec. These helpers are instead *generic* runtime
        //! utilities that a caller drives explicitly through an inherent async method, with no additional
        //! stream-combinator dependency.
        //!
        //! # Link-header pagination (RFC 5988 / RFC 8288)
        //!
        //! [`LinkPaginator<T>`] follows the common `Link: <url>; rel="next"` scheme (the GitHub-style
        //! convention). It is detectable purely at runtime with no spec metadata: each page's response
        //! carries the URL of the next page in its `Link` header. Drive it manually:
        //!
        //! ```ignore
        //! let first = reqwest::Url::parse("https://api.example.com/items?page=1")?;
        //! let mut pages = client.core().paginate_links::<Vec<Item>>(first);
        //! while let Some(page) = pages.next_page().await {
        //!     let items = page?.into_inner(); // a decoded `Vec<Item>` for this page
        //! }
        //! ```
        //!
        //! The generic paginator issues a plain `GET` for each page and does **not** attach per-operation
        //! security credentials — it has no operation context to know which scheme applies. To authenticate
        //! follow-up page requests, inject a [`reqwest::Client`] pre-configured with the appropriate default
        //! headers (e.g. an `Authorization` header) via `Client::with_client`; every page request then
        //! carries them. A page that comes back non-`2xx` (e.g. a `401` on an unauthenticated page 2)
        //! terminates the paginator as an [`Error::UnexpectedStatus`](super::Error), never a decoded page.
        //!
        //! Termination is otherwise driven by the server's `rel="next"` links. The paginator remembers
        //! every URL it has fetched, and a `next` link that resolves to one of them — a page linking to
        //! itself, or a longer cycle such as page 1 → page 2 → page 1 — ends the chain with
        //! [`Error::PaginationCycle`](super::Error) instead of fetching it again, so a buggy server's cycle
        //! surfaces as an error rather than as an endless loop or a silently truncated collection. URLs
        //! are compared as parsed, without their fragment, which is never sent. A server that mints a
        //! fresh URL for every page can still advertise an unbounded chain; the iterator is pull-based
        //! (nothing is fetched until you call `next_page`), so cap the number of pages you will follow
        //! where that matters.
        //!
        //! # Cursor / offset / page-number pagination (bring your own)
        //!
        //! Schemes the `Link` header cannot express — an opaque cursor or a `next_offset` field in the
        //! response body — are driven by the caller with a small loop over the ordinary generated operation
        //! method, using the fluent parameter setters to advance the cursor:
        //!
        //! ```ignore
        //! let mut cursor: Option<String> = None;
        //! loop {
        //!     let mut params = ListThingsParams::default();
        //!     if let Some(c) = &cursor {
        //!         params = params.cursor(c.clone());
        //!     }
        //!     let page = client.list_things(params).await?.into_inner();
        //!     handle(&page.items);
        //!     match page.next_cursor {
        //!         Some(next) => cursor = Some(next), // more pages
        //!         None => break,                     // done
        //!     }
        //! }
        //! ```
        //!
        //! The loop pattern above is the supported shape: Rust closures returning futures are awkward to
        //! type, and a plain loop over the generated operation method is clearer and fully typed.
        use std::collections::HashSet;
        use std::convert::Infallible;
        use std::marker::PhantomData;
        use reqwest::header::HeaderMap;
        use reqwest::Url;
        use serde::de::DeserializeOwned;
        use super::{
            decode_success, send, unexpected_status, ClientCore, Error, HttpBody,
            ResponseValue,
        };
        /// A manual async iterator over the pages of a `Link`-header-paginated collection.
        ///
        /// Holds the [`ClientCore`] and the URL of the next page to fetch (if any). Each [`Self::next_page`]
        /// `GET`s the current URL, decodes its body as `T`, reads the response's `Link: <…>; rel="next"`
        /// header to find the following page, and yields the decoded page. It returns `None` once a response
        /// carries no `rel="next"` link — or after any error, which terminates the paginator.
        ///
        /// `T` is the decoded body type of one page: typically a `Vec<Item>` for an array collection, or a
        /// wrapper struct whose fields include the items. Dropping the paginator is safe (standard HTTP drop
        /// semantics).
        pub struct LinkPaginator<T> {
            core: ClientCore,
            /// The next page to fetch; `None` once the chain is exhausted or an error terminated it.
            next: Option<Url>,
            /// Every URL this paginator has requested, fragment removed: a `next` that names one of them
            /// is a cycle.
            fetched: HashSet<Url>,
            /// `T` is produced, never consumed; the `fn() -> T` marker keeps `LinkPaginator<T>: Send + Sync`
            /// regardless of `T`.
            _marker: PhantomData<fn() -> T>,
        }
        impl<T> LinkPaginator<T> {
            /// Seed a paginator from the URL of the first page. No request is made until the first
            /// [`Self::next_page`] call.
            pub fn new(core: ClientCore, first: Url) -> Self {
                Self {
                    core,
                    next: Some(first),
                    fetched: HashSet::new(),
                    _marker: PhantomData,
                }
            }
            /// Seed a paginator from the headers of an already-fetched first response (the `rel="next"`
            /// link), so a caller who fetched page one through a normal operation method can continue from
            /// its headers. Only an absolute `next` URL is followed; a relative one yields no next page (use
            /// [`Self::new`] with the resolved URL instead). The first page's own URL is not known here,
            /// so a cycle back to it is caught one fetch later, when the refetched first page links on to
            /// a page this paginator already fetched.
            pub fn from_headers(core: ClientCore, headers: &HeaderMap) -> Self {
                Self {
                    core,
                    next: next_link(headers),
                    fetched: HashSet::new(),
                    _marker: PhantomData,
                }
            }
            /// Whether the next [`Self::next_page`] call returns `Some`: a fetched page, or the error that
            /// ends the chain, [`Error::PaginationCycle`] included.
            pub fn has_next(&self) -> bool {
                self.next.is_some()
            }
        }
        impl<T: DeserializeOwned> LinkPaginator<T> {
            /// Fetch and decode the next page, or return `None` at the end of the chain.
            ///
            /// `GET`s the current `next` URL, parses its response `Link` header for `rel="next"` (resolving a
            /// relative target against the fetched URL) to arm the following page, then decodes the body as
            /// `T`. Five things terminate the paginator (subsequent calls return `None`):
            ///
            /// * a `next` URL the paginator has already fetched (fragments aside) →
            ///   `Some(Err(Error::PaginationCycle { url }))`, without sending a request. The page whose
            ///   link closed the cycle was already yielded by the call before;
            /// * a request for the `next` URL that cannot be built →
            ///   `Some(Err(Error::RequestConstruction(..)))`;
            /// * a **transport failure** → `Some(Err(..))`;
            /// * a **non-success HTTP status** (anything outside `2xx`) → `Some(Err(Error::UnexpectedStatus))`
            ///   — the body is *never* decoded as `T`, so an error payload can't masquerade as a page. The
            ///   generic paginator has no per-operation error taxonomy, and it attaches no per-operation
            ///   credentials, so a follow-up page that `401`s (see the auth caveat in this module's docs)
            ///   surfaces here rather than being silently mis-decoded;
            /// * a **decode failure** on a `2xx` body → `Some(Err(Error::Decode))`.
            ///
            /// When a `2xx` page carries no `rel="next"` link, the page is yielded and the following call
            /// returns `None`.
            pub async fn next_page(
                &mut self,
            ) -> Option<Result<ResponseValue<T>, Error<Infallible>>> {
                let url = self.next.take()?;
                let mut key = url.clone();
                key.set_fragment(None);
                if !self.fetched.insert(key) {
                    return Some(Err(Error::PaginationCycle { url }));
                }
                let request = match self.core.http().get(url.clone()).build() {
                    Ok(request) => request,
                    Err(error) => return Some(Err(Error::request_construction(error))),
                };
                let response = match send(&self.core, request).await {
                    Ok(response) => response,
                    Err(error) => return Some(Err(error)),
                };
                self.handle_response(url, response).await
            }
            /// The post-`send` half of [`Self::next_page`]: gate on status, follow the `Link` header, decode.
            /// On entry `self.next` has already been taken (is `None`), so every non-success path here
            /// leaves the paginator disarmed; only a successful decode re-arms it.
            async fn handle_response(
                &mut self,
                url: Url,
                response: http::Response<HttpBody>,
            ) -> Option<Result<ResponseValue<T>, Error<Infallible>>> {
                if !response.status().is_success() {
                    return Some(
                        Err(unexpected_status::<Infallible>(&self.core, response).await),
                    );
                }
                let next = next_link_target(response.headers())
                    .and_then(|target| url.join(&target).ok());
                match decode_success::<T>(&self.core, response).await {
                    Ok(value) => {
                        self.next = next;
                        Some(Ok(value))
                    }
                    Err(error) => Some(Err(error)),
                }
            }
        }
        /// Extract the `rel="next"` target from a response's `Link` header(s) as an absolute [`Url`], or
        /// `None` when there is no usable next link. Pure and side-effect-free — the building block callers
        /// can reuse directly. A relative target is not resolved here (there is no base);
        /// [`LinkPaginator::next_page`] resolves relatives against the fetched page URL.
        pub fn next_link(headers: &HeaderMap) -> Option<Url> {
            next_link_target(headers).and_then(|target| Url::parse(&target).ok())
        }
        /// The RFC 8288 core: find the first `rel="next"` link across all `Link` header values and return its
        /// raw URI-reference (the text between `<` and `>`). Tolerant of quoted/unquoted `rel`, extra
        /// parameters, arbitrary whitespace, multiple links per header line and multiple header lines, and
        /// space-separated multi-value `rel` (e.g. `rel="next foo"`). Malformed input yields `None` — never a
        /// panic.
        fn next_link_target(headers: &HeaderMap) -> Option<String> {
            for value in headers.get_all(reqwest::header::LINK) {
                let Ok(field) = value.to_str() else {
                    continue;
                };
                for entry in split_outside(field, b',', true) {
                    if let Some((uri, true)) = parse_link_entry(entry) {
                        return Some(uri);
                    }
                }
            }
            None
        }
        /// Split `text` on `delim`, treating a delimiter inside a quoted string as literal (a backslash
        /// escapes the next character there). With `respect_angles`, a delimiter inside a `<…>`
        /// URI-reference is literal too, and a quote inside one opens no quoted string. A `Link` field
        /// value splits into entries on `,` with angles respected; an entry's parameter section splits on
        /// `;` without.
        fn split_outside(text: &str, delim: u8, respect_angles: bool) -> Vec<&str> {
            let bytes = text.as_bytes();
            let mut parts = Vec::new();
            let mut start = 0;
            let mut in_angle = false;
            let mut in_quote = false;
            let mut i = 0;
            while i < bytes.len() {
                match bytes[i] {
                    b'\\' if in_quote => {
                        i += 1;
                    }
                    b'<' if respect_angles && !in_quote => in_angle = true,
                    b'>' if respect_angles && !in_quote => in_angle = false,
                    b'"' if !in_angle => in_quote = !in_quote,
                    byte if byte == delim && !in_angle && !in_quote => {
                        parts.push(&text[start..i]);
                        start = i + 1;
                    }
                    _ => {}
                }
                i += 1;
            }
            parts.push(&text[start..]);
            parts
        }
        /// Parse a single `Link` entry into its URI-reference plus whether its `rel` names `next`. Returns
        /// `None` if no `<…>` URI is present.
        fn parse_link_entry(entry: &str) -> Option<(String, bool)> {
            let entry = entry.trim();
            let open = entry.find('<')?;
            let close = entry[open + 1..].find('>')? + open + 1;
            let uri = entry[open + 1..close].trim().to_owned();
            if uri.is_empty() {
                return None;
            }
            let mut is_next = false;
            for param in split_outside(&entry[close + 1..], b';', false) {
                let param = param.trim();
                let Some(eq) = param.find('=') else {
                    continue;
                };
                if !param[..eq].trim().eq_ignore_ascii_case("rel") {
                    continue;
                }
                let mut value = param[eq + 1..].trim();
                if value.len() >= 2 && value.starts_with('"') && value.ends_with('"') {
                    value = &value[1..value.len() - 1];
                }
                if value.split_whitespace().any(|rel| rel.eq_ignore_ascii_case("next")) {
                    is_next = true;
                }
            }
            Some((uri, is_next))
        }
    }
    mod response {
        use reqwest::header::HeaderMap;
        use reqwest::StatusCode;
        /// A successful response body paired with its status and headers. Returned inside
        /// `Result<ResponseValue<T>, Error<E>>` from every generated operation method.
        #[derive(Debug, Clone)]
        pub struct ResponseValue<T> {
            status: StatusCode,
            headers: HeaderMap,
            inner: T,
        }
        impl<T> ResponseValue<T> {
            /// Wrap a decoded body with its status and headers.
            pub fn new(status: StatusCode, headers: HeaderMap, inner: T) -> Self {
                Self { status, headers, inner }
            }
            /// The response status.
            pub fn status(&self) -> StatusCode {
                self.status
            }
            /// The response headers.
            pub fn headers(&self) -> &HeaderMap {
                &self.headers
            }
            /// Consume the wrapper, yielding the decoded body.
            pub fn into_inner(self) -> T {
                self.inner
            }
            /// Borrow the decoded body.
            pub fn inner(&self) -> &T {
                &self.inner
            }
            /// Map the body while preserving status and headers.
            pub fn map<U>(self, f: impl FnOnce(T) -> U) -> ResponseValue<U> {
                ResponseValue {
                    status: self.status,
                    headers: self.headers,
                    inner: f(self.inner),
                }
            }
        }
    }
    mod retry {
        //! A retry adapter for the transport seam: [`RetryBackend`] wraps any inner [`HttpBackend`] and
        //! re-executes a request per a caller-supplied [`RetryPolicy`], returning the last outcome once the
        //! policy stops or the request can no longer be replayed.
        //!
        //! ## Bring-your-own timing (no async timer in the runtime)
        //!
        //! The runtime has no async timer of its own, and the retry path never pulls in `tokio`, so the
        //! *wait* between attempts is supplied by the caller: [`RetryPolicy::retry`] returns the backoff
        //! as a boxed `Future` that the caller builds with their own runtime's timer (e.g.
        //! `tokio::time::sleep`).
        //! [`RetryBackend`] simply `.await`s that future; it never sleeps itself. A pure
        //! [`exponential_backoff`] helper computes the delay [`Duration`] a policy hands to its timer, so
        //! exponential backoff needs no runtime support either.
        //!
        //! ## Request replay and cloneability
        //!
        //! A retry re-sends the *same* request, which means it must be cloned before each attempt.
        //! [`HttpBody::try_clone`] returns `None` when the body is a one-shot stream that cannot be
        //! rewound. Such a request is executed **exactly once** and its outcome returned unretried — silently
        //! replaying half a consumed stream would send a corrupt body. Requests with an in-memory (or empty)
        //! body clone freely and retry normally; the clone carries the request's method, URI, version,
        //! headers and extensions too.
        //!
        //! ## Idempotency
        //!
        //! A request that timed out waiting for its response may already have been processed, so
        //! re-sending it repeats whatever it did. [`RetryOutcome::is_transient`], the default classifier,
        //! therefore answers `true` only for a request that is safe to repeat: one whose method is
        //! idempotent by [RFC 9110 §9.2.2](https://www.rfc-editor.org/rfc/rfc9110#section-9.2.2) (`GET`,
        //! `HEAD`, `OPTIONS`, `TRACE`, `PUT`, `DELETE`), or one the caller marked idempotent by sending an
        //! `Idempotency-Key` header, which asks the server to apply the request at most once. A policy that
        //! retries anything else keys on [`RetryOutcome::status`] / [`RetryOutcome::transport_error`]
        //! directly.
        //!
        //! ## `Retry-After` and sizing the backoff
        //!
        //! A `429` or `503` may say how long to wait in a `Retry-After` header, as delay-seconds or as an
        //! HTTP-date. [`RetryOutcome::retry_after`] parses both, and [`RetryOutcome::backoff`] takes that
        //! delay as a floor under [`exponential_backoff`], so the client never comes back sooner than the
        //! server asked. The floor is not capped by the backoff's `max`: a policy unwilling to wait that
        //! long stops instead of retrying early.
        //!
        //! Size `base` and `max` against the failures being retried: a backoff shorter than the network's
        //! loss bursts or the server's outages lands every retry inside the same bad state and spends the
        //! budget there. Pick a `base` above a typical loss burst and a `max` above a typical outage, so
        //! later attempts arrive after the condition has cleared.
        //!
        //! ```ignore
        //! use std::sync::Arc;
        //! use std::time::{Duration, SystemTime};
        //!
        //! // A policy that retries transient failures of idempotent requests up to five times with
        //! // exponential backoff, never sooner than the server's `Retry-After`, using the caller's tokio
        //! // timer for the wait — no timer lives in the runtime. The wait is a `RetryWait`, which is `Send`
        //! // on native and not on `wasm32`, so the policy compiles on both.
        //! struct Backoff;
        //! impl RetryPolicy for Backoff {
        //!     fn retry<'a>(&'a self, attempt: u32, outcome: &RetryOutcome<'_>) -> Option<RetryWait<'a>> {
        //!         if attempt < 5 && outcome.is_transient() {
        //!             let max = Duration::from_secs(5);
        //!             let wait = outcome.backoff(attempt, Duration::from_millis(100), max, SystemTime::now());
        //!             // A server asking for more than a minute is not worth waiting on here.
        //!             (wait <= Duration::from_secs(60)).then(|| Box::pin(tokio::time::sleep(wait)) as RetryWait<'a>)
        //!         } else {
        //!             None
        //!         }
        //!     }
        //! }
        //!
        //! let inner: Arc<dyn HttpBackend> = Arc::new(ReqwestBackend::new(reqwest::Client::new()));
        //! let backend: Arc<dyn HttpBackend> = Arc::new(RetryBackend::new(inner, Arc::new(Backoff)));
        //! let client = Client::with_backend(backend, "https://api.example.com")?;
        //! ```
        use std::sync::Arc;
        use std::time::{Duration, SystemTime, UNIX_EPOCH};
        use reqwest::header::RETRY_AFTER;
        use reqwest::{Method, StatusCode};
        use super::error::is_transient_status;
        use super::transport::{try_clone_request, ExecuteFuture, HttpBackend};
        use super::wasm::BoxFuture;
        use super::{HttpBody, MaybeSend, MaybeSync, TransportError};
        /// A request as the transport seam carries it.
        type Request = http::Request<HttpBody>;
        /// A response as the transport seam carries it.
        type Response = http::Response<HttpBody>;
        /// The boxed backoff future a [`RetryPolicy`] returns to request a retry after the wait completes.
        ///
        /// `Send` off `wasm32` and not on it, as the `wasm` module explains.
        pub type RetryWait<'a> = BoxFuture<'a, ()>;
        /// What one execution of a request produced, handed to [`RetryPolicy::retry`] so it can decide
        /// whether to retry: the [`http::Request`] that was sent, and either the raw [`http::Response`] the inner
        /// backend returned (any status — success or error) or the [`TransportError`] it failed with (DNS,
        /// connect, timeout, …).
        ///
        /// The policy inspects it to make its decision: [`RetryOutcome::status`] exposes the response status
        /// (e.g. retry on `429`/`5xx`), [`RetryOutcome::transport_error`] the transport failure (e.g. retry
        /// on a timeout), [`RetryOutcome::method`] the request method, [`RetryOutcome::retry_after`] the
        /// server's requested delay, and [`RetryOutcome::is_transient`] applies the runtime's own
        /// classifier as a sensible default.
        #[derive(Debug, Clone, Copy)]
        pub struct RetryOutcome<'a> {
            request: &'a Request,
            result: Result<&'a Response, &'a TransportError>,
        }
        impl<'a> RetryOutcome<'a> {
            /// The outcome of sending `request`: `Ok` with the response the inner backend returned, or
            /// `Err` with the transport failure it reported.
            pub fn new(
                request: &'a Request,
                result: Result<&'a Response, &'a TransportError>,
            ) -> Self {
                Self { request, result }
            }
            /// The request this attempt sent, as the next attempt would resend it.
            pub fn request(&self) -> &'a Request {
                self.request
            }
            /// The request's method.
            pub fn method(&self) -> &'a Method {
                self.request.method()
            }
            /// The response, if the attempt produced one (any status). `None` on a transport failure.
            pub fn response(&self) -> Option<&'a Response> {
                self.result.ok()
            }
            /// The transport failure, if the attempt failed before producing a response. `None` otherwise.
            pub fn transport_error(&self) -> Option<&'a TransportError> {
                self.result.err()
            }
            /// The response status, if any. `None` on a transport failure — a policy keying purely on
            /// status can treat that as "retry" or "stop" as it sees fit.
            pub fn status(&self) -> Option<StatusCode> {
                self.response().map(Response::status)
            }
            /// The outcome as a `Result`, mirroring what the inner backend returned.
            pub fn result(&self) -> Result<&'a Response, &'a TransportError> {
                self.result
            }
            /// Whether the request is safe to send again: its method is idempotent by RFC 9110 §9.2.2
            /// (`GET`, `HEAD`, `OPTIONS`, `TRACE`, `PUT`, `DELETE`), or it carries an `Idempotency-Key`
            /// header, which marks a request of any method as one the server applies at most once.
            pub fn is_idempotent(&self) -> bool {
                is_idempotent_method(self.method())
                    || self.request.headers().contains_key(IDEMPOTENCY_KEY)
            }
            /// Whether the outcome is worth retrying by the runtime's default classifier: the request
            /// [is idempotent](Self::is_idempotent), and the failure is one [`super::Error::is_transient`]
            /// calls transient for the error this outcome becomes. A `429` or `5xx` response is transient.
            /// A transport failure is transient when the class its [`TransportError`] carries is: a
            /// timeout, a failed connection, or an interrupted body is, and a redirect-policy, protocol,
            /// or request-kind failure ([`super::RequestError::Other`]) is not. [`super::ReqwestBackend`]
            /// classifies as [`super::Error::from_reqwest`] documents, so on `wasm32` a failed connection
            /// is request-kind there. A `POST` or `PATCH` without an `Idempotency-Key` is never
            /// transient here, since the server may already have applied it. Policies are free to ignore
            /// this and key on [`Self::status`] / [`Self::transport_error`] directly.
            pub fn is_transient(&self) -> bool {
                self.is_idempotent()
                    && match self.result {
                        Err(error) => error.is_transient(),
                        Ok(response) => is_transient_status(response.status()),
                    }
            }
            /// The delay the response's `Retry-After` header asks for, measured from `now`: its
            /// delay-seconds, or the time from `now` until its HTTP-date (zero once that date has passed).
            /// All three HTTP-date forms RFC 9110 §5.6.7 requires a recipient to accept are read: the
            /// IMF-fixdate, the obsolete RFC 850 form, and the asctime form. `None` on a transport failure,
            /// and for a response with no `Retry-After`, more than one, or one that does not parse.
            ///
            /// `now` is the caller's clock (`SystemTime::now()` off `wasm32`); the runtime reads none.
            pub fn retry_after(&self, now: SystemTime) -> Option<Duration> {
                let mut values = self.response()?.headers().get_all(RETRY_AFTER).iter();
                let value = values.next()?;
                if values.next().is_some() {
                    return None;
                }
                parse_retry_after(value.to_str().ok()?, now)
            }
            /// The wait before the next attempt: [`exponential_backoff`] of `attempt`, `base` and `max`,
            /// raised to the response's [`Self::retry_after`] delay where that is longer. The server's
            /// delay is a floor the backoff's `max` does not cap; a policy unwilling to wait that long
            /// stops instead of retrying.
            pub fn backoff(
                &self,
                attempt: u32,
                base: Duration,
                max: Duration,
                now: SystemTime,
            ) -> Duration {
                let wait = exponential_backoff(attempt, base, max);
                self.retry_after(now).map_or(wait, |floor| wait.max(floor))
            }
        }
        /// The header that marks a request idempotent whatever its method
        /// (draft-ietf-httpapi-idempotency-key-header).
        const IDEMPOTENCY_KEY: &str = "idempotency-key";
        /// Whether `method` is idempotent by RFC 9110 §9.2.2.
        fn is_idempotent_method(method: &Method) -> bool {
            [
                Method::GET,
                Method::HEAD,
                Method::OPTIONS,
                Method::TRACE,
                Method::PUT,
                Method::DELETE,
            ]
                .contains(method)
        }
        /// A caller-supplied retry policy: it decides whether to retry and, crucially, *provides the wait*.
        ///
        /// [`RetryBackend`] calls [`retry`](RetryPolicy::retry) after each attempt. Returning
        /// `Some(future)` means "retry after awaiting this future"; the future carries the backoff delay,
        /// built with the caller's own async timer (e.g. `tokio::time::sleep`) — this is how timing stays
        /// caller-owned and the retry path avoids a `tokio` dependency. Returning `None` stops retrying and the
        /// last outcome is returned.
        pub trait RetryPolicy: MaybeSend + MaybeSync {
            /// Called after attempt `attempt` (0-based) produced `outcome`. Return `Some(wait)` to retry
            /// after awaiting `wait` (which encapsulates the backoff delay using the caller's timer), or
            /// `None` to stop and return the outcome. The wait is a [`RetryWait`].
            fn retry<'a>(
                &'a self,
                attempt: u32,
                outcome: &RetryOutcome<'_>,
            ) -> Option<RetryWait<'a>>;
        }
        /// An [`HttpBackend`] that retries requests through an inner backend per a [`RetryPolicy`].
        ///
        /// It takes effect only when a caller wraps their backend in it and installs it via
        /// `Client::with_backend`. See this module's docs for the timing and cloneability contracts.
        #[derive(Clone)]
        pub struct RetryBackend {
            inner: Arc<dyn HttpBackend>,
            policy: Arc<dyn RetryPolicy>,
        }
        impl RetryBackend {
            /// Wrap `inner` so requests are retried according to `policy`.
            pub fn new(
                inner: Arc<dyn HttpBackend>,
                policy: Arc<dyn RetryPolicy>,
            ) -> Self {
                Self { inner, policy }
            }
            /// The wrapped inner backend.
            pub fn inner(&self) -> &Arc<dyn HttpBackend> {
                &self.inner
            }
        }
        impl std::fmt::Debug for RetryBackend {
            fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
                f.debug_struct("RetryBackend")
                    .field("inner", &self.inner)
                    .finish_non_exhaustive()
            }
        }
        impl HttpBackend for RetryBackend {
            fn execute(&self, request: Request) -> ExecuteFuture<'_> {
                Box::pin(async move {
                    let mut attempt: u32 = 0;
                    loop {
                        let Some(replay) = try_clone_request(&request) else {
                            return self.inner.execute(request).await;
                        };
                        let result = self.inner.execute(replay).await;
                        let decision = {
                            let outcome = RetryOutcome::new(&request, result.as_ref());
                            self.policy.retry(attempt, &outcome)
                        };
                        match decision {
                            Some(wait) => {
                                wait.await;
                                attempt = attempt.saturating_add(1);
                            }
                            None => return result,
                        }
                    }
                })
            }
        }
        /// Exponential backoff: `base * 2^attempt`, clamped to `max`. A pure helper a [`RetryPolicy`] can
        /// feed to its own async timer; the runtime never sleeps on it.
        ///
        /// `attempt` is 0-based, so attempt 0 waits `base`, attempt 1 waits `2 * base`, and so on. Overflow
        /// (a large `attempt` or `base`) saturates to `max` rather than panicking.
        pub fn exponential_backoff(
            attempt: u32,
            base: Duration,
            max: Duration,
        ) -> Duration {
            let factor = 2u32.saturating_pow(attempt);
            base.checked_mul(factor).unwrap_or(max).min(max)
        }
        /// A `Retry-After` field value as the delay it asks for from `now` (RFC 9110 §10.2.3): its
        /// delay-seconds, saturating where they exceed `u64`, or the time until its HTTP-date, zero once
        /// that has passed. `None` when the value is neither.
        fn parse_retry_after(value: &str, now: SystemTime) -> Option<Duration> {
            let value = value.trim_matches([' ', '\t']);
            if !value.is_empty() && value.bytes().all(|byte| byte.is_ascii_digit()) {
                return Some(Duration::from_secs(value.parse().unwrap_or(u64::MAX)));
            }
            let now = now
                .duration_since(UNIX_EPOCH)
                .map_or(
                    0,
                    |since| { i64::try_from(since.as_secs()).unwrap_or(i64::MAX) },
                );
            let at = parse_http_date(value, now)?;
            Some(Duration::from_secs(u64::try_from(at.saturating_sub(now)).unwrap_or(0)))
        }
        const SHORT_DAYS: [&str; 7] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
        const LONG_DAYS: [&str; 7] = [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
        ];
        const MONTHS: [&str; 12] = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec",
        ];
        /// An HTTP-date (RFC 9110 §5.6.7) as seconds since the Unix epoch, in any of its three forms:
        /// `Sun, 06 Nov 1994 08:49:37 GMT`, `Sunday, 06-Nov-94 08:49:37 GMT`, and
        /// `Sun Nov  6 08:49:37 1994`. `now`, in the same seconds, places the RFC 850 form's two-digit
        /// year: the year with those last two digits that is not more than 50 years after `now`'s.
        fn parse_http_date(value: &str, now: i64) -> Option<i64> {
            let (year, month, day, time) = if let Some((name, rest)) = value
                .split_once(", ")
            {
                if SHORT_DAYS.contains(&name) {
                    let mut fields = rest.split(' ');
                    let day = digits(fields.next()?, 2)?;
                    let month = month(fields.next()?)?;
                    let year = i64::from(digits(fields.next()?, 4)?);
                    let time = fields.next()?;
                    (fields.next()? == "GMT" && fields.next().is_none()).then_some(())?;
                    (year, month, day, time)
                } else if LONG_DAYS.contains(&name) {
                    let mut fields = rest.split(' ');
                    let mut date = fields.next()?.split('-');
                    let day = digits(date.next()?, 2)?;
                    let month = month(date.next()?)?;
                    let short_year = i64::from(digits(date.next()?, 2)?);
                    date.next().is_none().then_some(())?;
                    let time = fields.next()?;
                    (fields.next()? == "GMT" && fields.next().is_none()).then_some(())?;
                    let current = year_of_day(now.div_euclid(SECONDS_PER_DAY));
                    let mut year = current - current.rem_euclid(100) + short_year;
                    if year > current + 50 {
                        year -= 100;
                    }
                    (year, month, day, time)
                } else {
                    return None;
                }
            } else {
                let name = value.get(0..3)?;
                let separators = [3, 7, 10, 19]
                    .iter()
                    .all(|&at| value.get(at..=at) == Some(" "));
                (SHORT_DAYS.contains(&name) && separators && value.len() == 24)
                    .then_some(())?;
                let month = month(value.get(4..7)?)?;
                let day = value.get(8..10)?;
                let day = digits(
                    day.strip_prefix(' ').unwrap_or(day),
                    day.trim_start().len(),
                )?;
                let year = i64::from(digits(value.get(20..24)?, 4)?);
                (year, month, day, value.get(11..19)?)
            };
            let mut clock = time.split(':');
            let hour = digits(clock.next()?, 2)?;
            let minute = digits(clock.next()?, 2)?;
            let second = digits(clock.next()?, 2)?;
            let valid = clock.next().is_none() && hour < 24 && minute < 60
                && second <= 60 && (1..=days_in_month(year, month)).contains(&day);
            valid
                .then(|| {
                    days_from_civil(year, month, day) * SECONDS_PER_DAY
                        + i64::from(hour * 3600 + minute * 60 + second)
                })
        }
        const SECONDS_PER_DAY: i64 = 86_400;
        /// `text` as a decimal number, when it is exactly `len` ASCII digits.
        fn digits(text: &str, len: usize) -> Option<u32> {
            (text.len() == len && text.bytes().all(|byte| byte.is_ascii_digit()))
                .then(|| text.parse().ok())
                .flatten()
        }
        /// The 1-based month a three-letter month name names.
        fn month(name: &str) -> Option<u32> {
            let index = MONTHS.iter().position(|month| *month == name)?;
            u32::try_from(index + 1).ok()
        }
        fn days_in_month(year: i64, month: u32) -> u32 {
            let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
            match month {
                2 if leap => 29,
                2 => 28,
                4 | 6 | 9 | 11 => 30,
                _ => 31,
            }
        }
        /// Days since 1970-01-01 of a proleptic Gregorian date (Hinnant's `days_from_civil`).
        fn days_from_civil(year: i64, month: u32, day: u32) -> i64 {
            let year = if month <= 2 { year - 1 } else { year };
            let era = year.div_euclid(400);
            let year_of_era = year - era * 400;
            let day_of_year = (153 * i64::from((month + 9) % 12) + 2) / 5
                + i64::from(day) - 1;
            let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100
                + day_of_year;
            era * 146_097 + day_of_era - 719_468
        }
        /// The proleptic Gregorian year of a day counted from 1970-01-01 (Hinnant's `civil_from_days`).
        fn year_of_day(days: i64) -> i64 {
            let days = days + 719_468;
            let era = days.div_euclid(146_097);
            let day_of_era = days - era * 146_097;
            let year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36_524
                - day_of_era / 146_096) / 365;
            let day_of_year = day_of_era
                - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
            let shifted_month = (5 * day_of_year + 2) / 153;
            let year = year_of_era + era * 400;
            if shifted_month >= 10 { year + 1 } else { year }
        }
    }
    mod transport {
        //! The transport seam: how a prepared [`http::Request`] is executed into an [`http::Response`],
        //! both carrying the runtime's own body type, [`HttpBody`]. Everything else — URL building, auth
        //! attachment, decode, streaming, pagination — operates on the request/response *around* this one
        //! step, so swapping the backend swaps only the execute step and leaves the rest of the runtime
        //! untouched.
        //!
        //! The seam is a `dyn`-able trait ([`HttpBackend`]) so the generated `Client` stays non-generic:
        //! [`super::ClientCore`] holds an `Arc<dyn HttpBackend>` rather than a type parameter. The async
        //! method returns a manually boxed future ([`ExecuteFuture`], `Send` off wasm) instead of using
        //! `async-trait`, so std's `Future`/`Pin`/`Box` carry the abstraction.
        //!
        //! The currency is the `http` crate's request and response types, so a backend need not be built
        //! on reqwest. Failures are reported as a [`super::TransportError`] carrying the taxonomy class
        //! its constructor names; [`super::send`] maps it to that class's [`super::Error`] variant.
        //! [`ReqwestBackend`] adapts a `reqwest::Client` to the seam in both directions and classifies its
        //! failures with [`super::TransportError::from_reqwest`], so timeout/redirect/protocol
        //! classification is identical to executing directly on the reqwest client.
        use std::pin::Pin;
        use std::task::{Context, Poll};
        use bytes::{Bytes, BytesMut};
        use http_body::{Body as _, Frame, SizeHint};
        use super::wasm::BoxFuture;
        use super::{MaybeSend, MaybeSync, TransportError};
        /// The boxed future [`HttpBackend::execute`] returns: an executed [`http::Response`] or a
        /// [`TransportError`]. The `'a` lifetime ties the future to the borrow of `&self`, so a backend may
        /// borrow its own fields while the request runs (as [`ReqwestBackend`] borrows its client); a
        /// `'static` future fits too, since a longer lifetime coerces to the shorter one the trait
        /// requires.
        ///
        /// The future is `Send` off `wasm32` and not on it, since reqwest's `fetch`-backed futures are
        /// `!Send` on the single-threaded browser target; the `wasm` module explains the gating.
        pub type ExecuteFuture<'a> = BoxFuture<
            'a,
            Result<http::Response<HttpBody>, TransportError>,
        >;
        /// The swappable HTTP transport: it executes a prepared [`http::Request`] into an
        /// [`http::Response`], each carrying an [`HttpBody`].
        ///
        /// This is the seam the retry adapter, the middleware interceptor, and the WASM build all rest on:
        /// implement it to wrap, replace, or retry the execute step without touching URL building, auth,
        /// decode, streaming, or pagination. The default [`ReqwestBackend`] runs the request on a wrapped
        /// `reqwest::Client`.
        ///
        /// Implementations must be [`MaybeSend`] + [`MaybeSync`] — `Send + Sync` on native (the `Client` is
        /// shared across tasks), vacuous on `wasm32` — and `Debug` (so [`super::ClientCore`] stays `Debug`).
        /// The returned future is manually boxed so the trait is object-safe without an `async-trait`
        /// dependency.
        pub trait HttpBackend: MaybeSend + MaybeSync + std::fmt::Debug {
            /// Execute a prepared request, yielding the raw response or a transport failure. The request's
            /// URI is absolute. A backend that fails builds its [`TransportError`] with the constructor
            /// naming the failure's class, so [`super::send`] maps it to the right [`super::Error`]
            /// variant.
            fn execute(&self, request: http::Request<HttpBody>) -> ExecuteFuture<'_>;
        }
        /// The cause a body source may fail with, before it is read as a [`TransportError`].
        type BoxError = Box<dyn std::error::Error + Send + Sync>;
        /// A streaming body behind the seam: `Send + Sync` off `wasm32` and neither on it, as the `wasm`
        /// module explains. `Sync` is what lets [`ReqwestBackend`] hand a streaming request body to
        /// reqwest, which requires it.
        #[cfg(not(target_arch = "wasm32"))]
        type BoxBody = Pin<
            Box<dyn http_body::Body<Data = Bytes, Error = TransportError> + Send + Sync>,
        >;
        /// A streaming body behind the seam (the wasm variant: neither `Send` nor `Sync`).
        #[cfg(target_arch = "wasm32")]
        type BoxBody = Pin<
            Box<dyn http_body::Body<Data = Bytes, Error = TransportError>>,
        >;
        /// The body of a request or response crossing the transport seam: bytes held in memory, or a
        /// stream of them read as an [`http_body::Body`] whose failures are [`TransportError`]s.
        ///
        /// An in-memory body clones ([`Self::try_clone`]), which is what lets [`super::RetryBackend`]
        /// resend a request and `EventStream` reconnect one; a streaming body is read once.
        /// [`Self::wrap`] adopts any `http_body::Body`, so a backend built on another HTTP stack hands its
        /// response body over without copying it.
        pub struct HttpBody {
            inner: Inner,
        }
        enum Inner {
            /// Bytes held in memory: read as one data frame, then the end of the body.
            Full(Bytes),
            /// A body read frame by frame.
            Streaming(BoxBody),
            /// A request body reqwest's `fetch` backend holds as something other than bytes (a multipart
            /// form), which only [`ReqwestBackend`] can send.
            #[cfg(target_arch = "wasm32")]
            Reqwest(reqwest::Body),
            /// A response body reqwest's `fetch` backend received.
            #[cfg(target_arch = "wasm32")]
            Fetch(FetchBody),
        }
        impl HttpBody {
            /// A body with no bytes.
            pub fn empty() -> Self {
                Self::from(Bytes::new())
            }
            /// Adopt a streaming body. Its data frames are read as `Bytes`; a failure that is a
            /// [`TransportError`] keeps its class, and any other is
            /// [an interruption](TransportError::interrupted).
            pub fn wrap<B>(body: B) -> Self
            where
                B: http_body::Body + MaybeSend + MaybeSync + 'static,
                B::Data: Into<Bytes>,
                B::Error: Into<BoxError>,
            {
                Self {
                    inner: Inner::Streaming(
                        Box::pin(SourceBody {
                            inner: Box::pin(body),
                        }),
                    ),
                }
            }
            /// The bytes of an in-memory body; `None` for a streaming one.
            pub fn as_bytes(&self) -> Option<&[u8]> {
                match &self.inner {
                    Inner::Full(bytes) => Some(bytes),
                    Inner::Streaming(_) => None,
                    #[cfg(target_arch = "wasm32")]
                    Inner::Fetch(_) => None,
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(body) => body.as_bytes(),
                }
            }
            /// A copy of an in-memory body, sharing its bytes; `None` for a streaming one, which can be
            /// read only once.
            pub fn try_clone(&self) -> Option<Self> {
                match &self.inner {
                    Inner::Full(bytes) => Some(Self::from(bytes.clone())),
                    Inner::Streaming(_) => None,
                    #[cfg(target_arch = "wasm32")]
                    Inner::Fetch(_) => None,
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(_) => None,
                }
            }
            /// The next chunk of data, or `None` once the body has ended. Frames that carry no data
            /// (trailers) are skipped.
            pub(crate) async fn chunk(
                &mut self,
            ) -> Result<Option<Bytes>, TransportError> {
                std::future::poll_fn(|cx| self.poll_chunk(cx)).await
            }
            /// [`Self::chunk`] as a poll, for a reader that is itself polled (`EventStream`).
            pub(crate) fn poll_chunk(
                &mut self,
                cx: &mut Context<'_>,
            ) -> Poll<Result<Option<Bytes>, TransportError>> {
                loop {
                    match Pin::new(&mut *self).poll_frame(cx) {
                        Poll::Pending => return Poll::Pending,
                        Poll::Ready(None) => return Poll::Ready(Ok(None)),
                        Poll::Ready(Some(Err(error))) => return Poll::Ready(Err(error)),
                        Poll::Ready(Some(Ok(frame))) => {
                            if let Ok(data) = frame.into_data() {
                                return Poll::Ready(Ok(Some(data)));
                            }
                        }
                    }
                }
            }
            /// The whole body. An in-memory body is handed over without a copy, and so is a streaming
            /// one that arrives as a single chunk.
            pub(crate) async fn collect(mut self) -> Result<Bytes, TransportError> {
                if let Inner::Full(bytes) = self.inner {
                    return Ok(bytes);
                }
                let Some(first) = self.chunk().await? else {
                    return Ok(Bytes::new());
                };
                let Some(second) = self.chunk().await? else {
                    return Ok(first);
                };
                let mut buffered = BytesMut::with_capacity(first.len() + second.len());
                buffered.extend_from_slice(&first);
                buffered.extend_from_slice(&second);
                while let Some(chunk) = self.chunk().await? {
                    buffered.extend_from_slice(&chunk);
                }
                Ok(buffered.freeze())
            }
            /// A request body reqwest built, as the seam carries it. Off `wasm32` an in-memory body
            /// moves over without a copy, and anything else is read as a stream. On `wasm32` an in-memory
            /// body is copied, and a multipart form stays reqwest's, for [`ReqwestBackend`] to send.
            ///
            /// One function for both targets, with the target-specific steps `cfg`-gated inside it, so a
            /// native test reaches it and no mutation of it survives by being compiled out.
            fn from_reqwest_request(
                #[allow(unused_mut)]
                mut body: reqwest::Body,
            ) -> Self {
                #[cfg(target_arch = "wasm32")]
                return match body.as_bytes() {
                    Some(bytes) => Self::from(Bytes::copy_from_slice(bytes)),
                    None => {
                        Self {
                            inner: Inner::Reqwest(body),
                        }
                    }
                };
                #[cfg(not(target_arch = "wasm32"))]
                {
                    if body.as_bytes().is_none() {
                        return Self::from_reqwest_stream(body);
                    }
                    let mut cx = Context::from_waker(std::task::Waker::noop());
                    match Pin::new(&mut body).poll_frame(&mut cx) {
                        Poll::Ready(Some(Ok(frame))) => {
                            Self::from(frame.into_data().unwrap_or_default())
                        }
                        Poll::Ready(None) => Self::empty(),
                        Poll::Ready(Some(Err(_))) | Poll::Pending => {
                            Self::from_reqwest_stream(body)
                        }
                    }
                }
            }
            /// A body reqwest reads, read through [`TransportError::from_reqwest_body`].
            #[cfg(not(target_arch = "wasm32"))]
            fn from_reqwest_stream(body: reqwest::Body) -> Self {
                Self {
                    inner: Inner::Streaming(Box::pin(ReqwestBody { inner: body })),
                }
            }
            /// The `fetch` response a body reqwest's `fetch` backend received still holds, before anything
            /// has read it; any other body comes back unchanged. The `allow` is for a build without the
            /// `stream` module, its only caller.
            #[cfg(target_arch = "wasm32")]
            #[allow(dead_code)]
            pub(crate) fn into_fetch_response(self) -> Result<reqwest::Response, Self> {
                match self.inner {
                    Inner::Fetch(FetchBody::Unread(response)) => Ok(response),
                    inner => Err(Self { inner }),
                }
            }
            /// The body as reqwest sends it. reqwest's `fetch` backend on `wasm32` takes no stream, so
            /// there a streaming body is refused as a request-kind failure.
            fn into_reqwest(self) -> Result<reqwest::Body, TransportError> {
                match self.inner {
                    Inner::Full(bytes) => Ok(reqwest::Body::from(bytes)),
                    #[cfg(not(target_arch = "wasm32"))]
                    Inner::Streaming(body) => Ok(reqwest::Body::wrap(body)),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Streaming(_) | Inner::Fetch(_) => {
                        Err(
                            TransportError::request(
                                "reqwest's fetch backend cannot send a streaming request body",
                            ),
                        )
                    }
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(body) => Ok(body),
                }
            }
        }
        impl http_body::Body for HttpBody {
            type Data = Bytes;
            type Error = TransportError;
            fn poll_frame(
                mut self: Pin<&mut Self>,
                cx: &mut Context<'_>,
            ) -> Poll<Option<Result<Frame<Bytes>, TransportError>>> {
                match &mut self.inner {
                    Inner::Full(bytes) if bytes.is_empty() => Poll::Ready(None),
                    Inner::Full(bytes) => {
                        Poll::Ready(Some(Ok(Frame::data(std::mem::take(bytes)))))
                    }
                    Inner::Streaming(body) => body.as_mut().poll_frame(cx),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Fetch(body) => Pin::new(body).poll_frame(cx),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(_) => {
                        self.inner = Inner::Full(Bytes::new());
                        Poll::Ready(
                            Some(
                                Err(
                                    TransportError::request(
                                        "a multipart request body built by reqwest is sent only by ReqwestBackend",
                                    ),
                                ),
                            ),
                        )
                    }
                }
            }
            fn is_end_stream(&self) -> bool {
                match &self.inner {
                    Inner::Full(bytes) => bytes.is_empty(),
                    Inner::Streaming(body) => body.is_end_stream(),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(_) => false,
                    #[cfg(target_arch = "wasm32")]
                    Inner::Fetch(_) => false,
                }
            }
            fn size_hint(&self) -> SizeHint {
                match &self.inner {
                    Inner::Full(bytes) => SizeHint::with_exact(bytes.len() as u64),
                    Inner::Streaming(body) => body.size_hint(),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(_) | Inner::Fetch(_) => SizeHint::default(),
                }
            }
        }
        impl Default for HttpBody {
            fn default() -> Self {
                Self::empty()
            }
        }
        impl std::fmt::Debug for HttpBody {
            fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
                match &self.inner {
                    Inner::Full(bytes) => {
                        f.debug_tuple("HttpBody").field(&bytes.len()).finish()
                    }
                    Inner::Streaming(_) => f.write_str("HttpBody(streaming)"),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Reqwest(_) => f.write_str("HttpBody(reqwest)"),
                    #[cfg(target_arch = "wasm32")]
                    Inner::Fetch(_) => f.write_str("HttpBody(fetch)"),
                }
            }
        }
        impl From<Bytes> for HttpBody {
            fn from(bytes: Bytes) -> Self {
                Self { inner: Inner::Full(bytes) }
            }
        }
        impl From<Vec<u8>> for HttpBody {
            fn from(bytes: Vec<u8>) -> Self {
                Self::from(Bytes::from(bytes))
            }
        }
        impl From<String> for HttpBody {
            fn from(text: String) -> Self {
                Self::from(Bytes::from(text))
            }
        }
        impl From<&'static str> for HttpBody {
            fn from(text: &'static str) -> Self {
                Self::from(Bytes::from_static(text.as_bytes()))
            }
        }
        impl From<&'static [u8]> for HttpBody {
            fn from(bytes: &'static [u8]) -> Self {
                Self::from(Bytes::from_static(bytes))
            }
        }
        /// An adopted body: its data read as `Bytes`, and its failures as [`TransportError`]s.
        struct SourceBody<B> {
            inner: Pin<Box<B>>,
        }
        impl<B> http_body::Body for SourceBody<B>
        where
            B: http_body::Body,
            B::Data: Into<Bytes>,
            B::Error: Into<BoxError>,
        {
            type Data = Bytes;
            type Error = TransportError;
            fn poll_frame(
                mut self: Pin<&mut Self>,
                cx: &mut Context<'_>,
            ) -> Poll<Option<Result<Frame<Bytes>, TransportError>>> {
                self.inner
                    .as_mut()
                    .poll_frame(cx)
                    .map(|frame| {
                        frame
                            .map(|frame| {
                                frame
                                    .map(|frame| frame.map_data(Into::into))
                                    .map_err(|error| TransportError::from_body_source(
                                        error.into(),
                                    ))
                            })
                    })
            }
            fn is_end_stream(&self) -> bool {
                self.inner.is_end_stream()
            }
            fn size_hint(&self) -> SizeHint {
                self.inner.size_hint()
            }
        }
        /// A body reqwest reads, its failures classified by [`TransportError::from_reqwest_body`].
        #[cfg(not(target_arch = "wasm32"))]
        struct ReqwestBody {
            inner: reqwest::Body,
        }
        #[cfg(not(target_arch = "wasm32"))]
        impl http_body::Body for ReqwestBody {
            type Data = Bytes;
            type Error = TransportError;
            fn poll_frame(
                mut self: Pin<&mut Self>,
                cx: &mut Context<'_>,
            ) -> Poll<Option<Result<Frame<Bytes>, TransportError>>> {
                Pin::new(&mut self.inner)
                    .poll_frame(cx)
                    .map(|frame| {
                        frame
                            .map(|frame| {
                                frame.map_err(TransportError::from_reqwest_body)
                            })
                    })
            }
            fn is_end_stream(&self) -> bool {
                self.inner.is_end_stream()
            }
            fn size_hint(&self) -> SizeHint {
                self.inner.size_hint()
            }
        }
        /// A response body reqwest's `fetch` backend reads whole, its failure classified by
        /// [`TransportError::from_reqwest_body`]. Until it is first polled it holds the response itself,
        /// which the `stream` module takes back to read chunk by chunk as the browser delivers them
        /// ([`HttpBody::into_fetch_response`]), since only an API with a streaming response carries the
        /// dependencies that read needs.
        #[cfg(target_arch = "wasm32")]
        enum FetchBody {
            /// Not read yet.
            Unread(reqwest::Response),
            /// Being read whole.
            Reading(BoxFuture<'static, Result<Bytes, reqwest::Error>>),
            /// Read, or failed.
            Done,
        }
        #[cfg(target_arch = "wasm32")]
        impl http_body::Body for FetchBody {
            type Data = Bytes;
            type Error = TransportError;
            fn poll_frame(
                mut self: Pin<&mut Self>,
                cx: &mut Context<'_>,
            ) -> Poll<Option<Result<Frame<Bytes>, TransportError>>> {
                loop {
                    match std::mem::replace(&mut *self, FetchBody::Done) {
                        FetchBody::Unread(response) => {
                            *self = FetchBody::Reading(Box::pin(response.bytes()));
                        }
                        FetchBody::Reading(mut whole) => {
                            return match std::future::Future::poll(whole.as_mut(), cx) {
                                Poll::Pending => {
                                    *self = FetchBody::Reading(whole);
                                    Poll::Pending
                                }
                                Poll::Ready(read) => {
                                    Poll::Ready(
                                        Some(
                                            read
                                                .map(Frame::data)
                                                .map_err(TransportError::from_reqwest_body),
                                        ),
                                    )
                                }
                            };
                        }
                        FetchBody::Done => return Poll::Ready(None),
                    }
                }
            }
        }
        /// A request reqwest built, as the seam carries it. A URL that is not a valid URI is refused here
        /// as reqwest refuses it at `execute`, as a builder-kind error.
        ///
        /// The request's total timeout crosses with it: off `wasm32` reqwest keeps it among the request's
        /// extensions, which the conversion carries; on `wasm32` it is a field the conversion drops, so it
        /// is carried as a `FetchTimeout` extension, which [`request_into_reqwest`] reads back.
        pub(crate) fn request_from_reqwest(
            request: reqwest::Request,
        ) -> Result<http::Request<HttpBody>, reqwest::Error> {
            #[cfg(target_arch = "wasm32")]
            let timeout = request.timeout().copied();
            let request = http::Request::<reqwest::Body>::try_from(request)?;
            #[allow(unused_mut)]
            let mut request = request.map(HttpBody::from_reqwest_request);
            #[cfg(target_arch = "wasm32")]
            if let Some(timeout) = timeout {
                request.extensions_mut().insert(FetchTimeout(timeout));
            }
            Ok(request)
        }
        /// A request's total timeout as it crosses the seam on `wasm32`, where reqwest's own request
        /// keeps it outside the extensions its conversion carries.
        #[cfg(target_arch = "wasm32")]
        #[derive(Clone, Copy, Debug)]
        struct FetchTimeout(std::time::Duration);
        /// A copy of `request` to send again, its method, URI, version, headers, extensions and body
        /// alike; `None` when its body is a stream, which can be read only once.
        pub(crate) fn try_clone_request(
            request: &http::Request<HttpBody>,
        ) -> Option<http::Request<HttpBody>> {
            let mut clone = http::Request::new(request.body().try_clone()?);
            *clone.method_mut() = request.method().clone();
            *clone.uri_mut() = request.uri().clone();
            *clone.version_mut() = request.version();
            *clone.headers_mut() = request.headers().clone();
            *clone.extensions_mut() = request.extensions().clone();
            Some(clone)
