        /// (see [`decode_text_body`]): `String` yields `""`, a typed value with no empty member yields
        /// [`Error::Decode`].
        pub async fn decode_success_text<T>(
            core: &ClientCore,
            response: Response,
        ) -> Result<ResponseValue<T>, Error<Infallible>>
        where
            T: DeserializeOwned,
