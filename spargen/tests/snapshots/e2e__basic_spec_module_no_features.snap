        /// at `max_error_body`. A zero-length body is not a JSON value, so it is always [`Error::Decode`],
        /// whatever `T` is.
        pub async fn decode_success<T>(
            core: &ClientCore,
            response: Response,
        ) -> Result<ResponseValue<T>, Error<Infallible>>
        where
            T: DeserializeOwned,
        {
