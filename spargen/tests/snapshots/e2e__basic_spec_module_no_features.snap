        /// Append `name=value` to the request URL's query, `application/x-www-form-urlencoded` as reqwest's
        /// `RequestBuilder::query` encodes it, after whatever query the URL already carries. Written
        /// against the built request because `query` needs reqwest's `query` feature, which would add
        /// `serde_urlencoded` to every consumer's graph. A builder that already failed reports that
        /// failure here, as the request-construction error `build` would have raised.
        fn append_query_pair(
            request: RequestBuilder,
            name: &str,
            value: &str,
        ) -> Result<RequestBuilder, Error<Infallible>> {
            let (client, request) = request.build_split();
            let mut request = request.map_err(Error::request_construction)?;
            request.url_mut().query_pairs_mut().append_pair(name, value);
            Ok(RequestBuilder::from_parts(client, request))
        }
        /// Add `name=value` to the request's one `Cookie` header. RFC 6265 §5.4 allows a user agent a
        /// single `Cookie` header, and `RequestBuilder::header` appends a second, so the cookie joins any
        /// value the request already carries (the operation's cookie parameters, or an earlier cookie
        /// apiKey of the same alternative) after a `; `. The merged value carries the secret, so it is
        /// marked sensitive. A builder that already failed reports that failure here, as the
        /// request-construction error `build` would have raised.
        fn append_cookie(
            request: RequestBuilder,
            name: &str,
            value: &str,
        ) -> Result<RequestBuilder, Error<Infallible>> {
            let (client, request) = request.build_split();
            let mut request = request.map_err(Error::request_construction)?;
            let headers = request.headers_mut();
            let mut cookie = Vec::new();
            for existing in headers.get_all(reqwest::header::COOKIE) {
                cookie.extend_from_slice(existing.as_bytes());
                cookie.extend_from_slice(b"; ");
            }
            cookie.extend_from_slice(name.as_bytes());
            cookie.push(b'=');
            cookie.extend_from_slice(value.as_bytes());
            let mut merged = HeaderValue::from_bytes(&cookie)
                .map_err(Error::request_construction)?;
            merged.set_sensitive(true);
            headers.insert(reqwest::header::COOKIE, merged);
            Ok(RequestBuilder::from_parts(client, request))
        }
        fn sensitive_value(secret: &str) -> Result<HeaderValue, Error<Infallible>> {
            let mut value = HeaderValue::from_str(secret)
                .map_err(Error::request_construction)?;
            value.set_sensitive(true);
            Ok(value)
        }
        fn credential_mismatch(
            scheme: &'static str,
            required: &'static str,
            credential: &Credential,
        ) -> Error<Infallible> {
            Error::RequestConstruction(RequestError::CredentialMismatch {
                scheme,
                required,
                registered: credential.kind_name(),
            })
        }
    }
    mod client {
        use std::collections::HashMap;
        use std::convert::Infallible;
        use std::sync::Arc;
        use std::time::Duration;
        use reqwest::Url;
        use super::{Credential, Error, HttpBackend, LinkPaginator, ReqwestBackend};
        /// Client-wide configuration.
        #[derive(Debug, Clone)]
        pub struct ClientConfig {
            /// Maximum bytes of a response body retained on error variants; the rest is dropped
            /// (default 64 KiB).
            ///
            /// Where it applies, and what says so:
            ///
            /// - Bodies read as errors are capped, and on native targets the cap bounds *reading* too —
            ///   an over-cap body is abandoned partway, which forgoes reuse of that connection. On
            ///   `wasm32`, `ReqwestBackend` delivers every `fetch` body whole, an error body of a
            ///   streaming operation included, so there only retention is guaranteed to be bounded.
            /// - A success body that fails to decode is capped on retention only. Deserialization needs
            ///   the whole body, so it is always read whole.
            /// - [`Error::Decode`] reports truncation through its `truncated` field. [`Error::Api`] and
            ///   [`Error::UnexpectedStatus`] have no such field, so where they are capped they are capped
            ///   silently.
            /// - One path is **not** capped by it: `EventStream`'s per-frame decode, which
            ///   [`Self::max_stream_frame`] bounds instead.
            pub max_error_body: usize,
            /// Maximum bytes `EventStream` buffers for one item whose terminator has not arrived yet
            /// (default 16 MiB): an SSE event before its blank line, an ndjson line before its newline, a
            /// JSON text sequence record before the next separator.
            ///
            /// Once more than this many bytes of such an item are buffered, the stream yields
            /// [`Error::Decode`] retaining at most `max_error_body` bytes of them, with `truncated` set,
            /// and then ends, without consulting a reconnect policy. Complete items read in the same
            /// chunk ahead of the over-limit one are yielded first. Bytes arrive a chunk at a time, so the
            /// buffer may hold up to one chunk more than this limit before the check runs, and an item
            /// whose terminator arrives in the same chunk that takes it past the limit is framed
            /// normally.
            ///
            /// It also bounds what a per-frame decode failure retains: an item within the limit that
            /// fails to decode is reported as [`Error::Decode`] retaining the whole frame, uncapped by
            /// `max_error_body`, with `truncated` unset.
            pub max_stream_frame: usize,
            /// How long establishing a connection may take — name resolution, the TCP handshake and TLS —
            /// before the request fails with [`Error::Timeout`] (default 30 s; `None` waits as long as
            /// the operating system does).
            ///
            /// It is read once, when [`ClientCore::with_config`] or [`ClientCore::new`] builds the
            /// `reqwest::Client`, so changing it through [`ClientCore::config_mut`] afterwards changes
            /// nothing. A client injected with [`ClientCore::with_client`] keeps its own connect timeout
            /// instead, and a backend installed with [`ClientCore::with_backend`] executes requests on its
            /// own terms. reqwest's `fetch` backend has no connect timeout, so on `wasm32` it is ignored.
            pub connect_timeout: Option<Duration>,
            /// How long a read on an established connection may wait for its next bytes — the response
            /// head, or the next chunk of a body, a streamed one included — before the request fails with
            /// [`Error::Timeout`] (default 5 min; `None` waits indefinitely). Each read that arrives
            /// restarts it, so it bounds a stall, not the length of a response. An event stream whose
            /// server sends nothing, not even a comment or heartbeat, for longer than this fails with
            /// [`Error::Timeout`], which a reconnect policy may answer by resuming it.
            ///
            /// It is read when the `reqwest::Client` is built and applies where it applies, exactly as
            /// [`Self::connect_timeout`] describes; reqwest's `fetch` backend has no read timeout
            /// either, so on `wasm32` it is ignored.
            pub read_timeout: Option<Duration>,
            /// How long one non-streaming request may take in total, from connecting until its whole
            /// response body has been read, before it fails with [`Error::Timeout`] (default `None`: no
            /// total bound, only the connect and read timeouts).
            ///
            /// It is read each time [`super::send`] sends a request, so changing it through
            /// [`ClientCore::config_mut`] applies from the next request on, whichever constructor built
            /// the core, and it is honoured on `wasm32` too. A generated client's `with_timeout` sets it
            /// on the client value it returns, which is how one call gets a deadline of its own. It
            /// travels on the request itself: a request built with its own
            /// `reqwest::RequestBuilder::timeout` keeps that one,
            /// [`ReqwestBackend`] enforces it, and a caller-supplied [`HttpBackend`] that runs the
            /// request on a `reqwest::Client` enforces it as well. A streaming response is exempt,
            /// because a stream may rightly stay open indefinitely: an operation returning an
            /// `EventStream` sends its request with [`super::send_streaming`], which never applies it, and
            /// each reconnect resends that same request.
            pub timeout: Option<Duration>,
        }
        impl Default for ClientConfig {
            fn default() -> Self {
                Self {
                    max_error_body: 64 * 1024,
                    max_stream_frame: 16 * 1024 * 1024,
                    connect_timeout: Some(Duration::from_secs(30)),
                    read_timeout: Some(Duration::from_secs(5 * 60)),
                    timeout: None,
                }
            }
        }
        /// The shared core every generated `Client` wraps: the `reqwest::Client` used to BUILD requests
        /// (the BYO-client injection point for TLS choice, proxies, timeouts), the swappable transport
        /// [`HttpBackend`] that EXECUTES them, the base URL, configuration, and per-scheme credentials.
        ///
        /// Request building stays on a concrete `reqwest::Client`; only the execute step is routed through
        /// the backend (see [`super::send`]). `new`/`with_client` install the default [`ReqwestBackend`];
        /// `with_backend` plugs a caller-supplied transport.
        ///
        /// The generated `Client` wraps one of these and documents its own constructors; each of its
        /// operation methods delegates to the shared dispatch routines.
        #[derive(Debug, Clone)]
        pub struct ClientCore {
            http: reqwest::Client,
            backend: Arc<dyn HttpBackend>,
            base_url: Url,
            config: ClientConfig,
            credentials: HashMap<String, Credential>,
        }
        impl ClientCore {
            /// Build a core with the default [`ClientConfig`] and the given base URL, as
            /// [`Self::with_config`] does.
            pub fn new(base_url: &str) -> Result<Self, Error<Infallible>> {
                Self::with_config(base_url, ClientConfig::default())
            }
            /// Build a core with the given base URL and configuration on a `reqwest::Client` built from
            /// `config`'s [connect](ClientConfig::connect_timeout) and
            /// [read](ClientConfig::read_timeout) timeouts, which both builds requests and, wrapped in
            /// the default [`ReqwestBackend`], executes them. Returns a request-construction error if the
            /// base URL is invalid or reqwest cannot build the client (its TLS backend fails to
            /// initialise).
            pub fn with_config(
                base_url: &str,
                config: ClientConfig,
            ) -> Result<Self, Error<Infallible>> {
                let client = http_client(&config)?;
                let backend = Arc::new(ReqwestBackend::new(client.clone()));
                Self::assemble(client, backend, base_url, config)
            }
            /// Build a core with a caller-supplied `reqwest::Client` — the injection point for TLS backend,
            /// proxies, and timeouts. The client both builds requests and, wrapped in the default
            /// [`ReqwestBackend`], executes them, so its own connect and read timeouts apply instead of
            /// [`ClientConfig::connect_timeout`] and [`ClientConfig::read_timeout`];
            /// [`ClientConfig::timeout`] still applies to each request [`super::send`] sends.
            pub fn with_client(
                client: reqwest::Client,
                base_url: &str,
            ) -> Result<Self, Error<Infallible>> {
                let backend = Arc::new(ReqwestBackend::new(client.clone()));
                Self::assemble(client, backend, base_url, ClientConfig::default())
            }
            /// Build a core with a caller-supplied transport [`HttpBackend`] — the injection point for
            /// retry, middleware, or an entirely non-reqwest transport. Requests are still BUILT on a
            /// `reqwest::Client` configured as [`Self::new`]'s is; only the execute step goes through
            /// `backend`, so connecting and reading are bounded however `backend` bounds them.
            /// [`ClientConfig::timeout`] travels on each request [`super::send`] sends, for a backend that
            /// runs it on a `reqwest::Client` to enforce.
            pub fn with_backend(
                backend: Arc<dyn HttpBackend>,
                base_url: &str,
            ) -> Result<Self, Error<Infallible>> {
                let config = ClientConfig::default();
                Self::assemble(http_client(&config)?, backend, base_url, config)
            }
            fn assemble(
                http: reqwest::Client,
                backend: Arc<dyn HttpBackend>,
                base_url: &str,
                config: ClientConfig,
            ) -> Result<Self, Error<Infallible>> {
                let base_url = Url::parse(base_url)
                    .map_err(Error::request_construction)?;
                Ok(Self {
                    http,
                    backend,
                    base_url,
                    config,
                    credentials: HashMap::new(),
                })
            }
            /// The retention/config settings.
            pub fn config(&self) -> &ClientConfig {
                &self.config
            }
            /// Mutably borrow the retention/config settings.
            pub fn config_mut(&mut self) -> &mut ClientConfig {
                &mut self.config
            }
            /// The base URL.
            pub fn base_url(&self) -> &Url {
                &self.base_url
            }
            /// The injected HTTP client used to BUILD requests.
            pub fn http(&self) -> &reqwest::Client {
                &self.http
            }
            /// The transport backend that EXECUTES requests. [`super::send`] dispatches through this;
            /// retry/middleware layers can clone the `Arc` to wrap it.
            pub fn backend(&self) -> &Arc<dyn HttpBackend> {
                &self.backend
            }
            /// Register a credential for a named security scheme, replacing any already registered for it.
            pub fn set_credential(&mut self, scheme: &str, credential: Credential) {
                self.credentials.insert(scheme.to_owned(), credential);
            }
            /// Unregister the credential for a named security scheme, returning it if one was registered.
            ///
            /// This is how a caller reaches a later security alternative, as [`super::attach_auth`]
            /// describes. Removing a scheme that was never registered is a no-op returning `None`.
            pub fn remove_credential(&mut self, scheme: &str) -> Option<Credential> {
                self.credentials.remove(scheme)
            }
            /// Retrieve a registered credential by scheme name.
            pub fn credential(&self, scheme: &str) -> Option<&Credential> {
                self.credentials.get(scheme)
            }
            /// Start a [`LinkPaginator<T>`] over a `Link`-header-paginated collection, beginning at `first`.
            /// See the `paginate` module's docs for the full pattern and the authentication caveat.
            pub fn paginate_links<T>(&self, first: Url) -> LinkPaginator<T> {
                LinkPaginator::new(self.clone(), first)
            }
        }
        /// The `reqwest::Client` a core builds for itself, with `config`'s connect and read timeouts.
        /// reqwest's `fetch` backend has neither, so on `wasm32` `config` is not read.
        fn http_client(
            config: &ClientConfig,
        ) -> Result<reqwest::Client, Error<Infallible>> {
            let builder = reqwest::Client::builder();
            #[cfg(not(target_arch = "wasm32"))]
            let builder = {
                let mut builder = builder;
                if let Some(timeout) = config.connect_timeout {
                    builder = builder.connect_timeout(timeout);
                }
                if let Some(timeout) = config.read_timeout {
                    builder = builder.read_timeout(timeout);
                }
                builder
            };
            #[cfg(target_arch = "wasm32")]
            let _ = config;
            builder.build().map_err(Error::request_construction)
        }
    }
    mod dispatch {
        //! The dispatch routines every operation of a generated client shares: build URL → attach auth
        //! (in the `auth` module) → send → classify status → decode. Sharing happens *within* a generated
        //! client (not via a shared crate).
        //!
        //! URL building and sending are non-generic. The success decoders are generic over the body type
        //! and the error classifiers over the operation's error type `E`; each takes the body codec as a
        //! closure over the shared `decode_success_with` / `classify_with` routine, so one copy of each
        //! is monomorphized per distinct body or error type.
        use std::convert::Infallible;
        use bytes::Bytes;
        use reqwest::{Request, Url};
        use serde::de::DeserializeOwned;
        use super::transport::request_from_reqwest;
        use super::{ClientCore, Error, HttpBackend, HttpBody, ResponseValue};
        /// A response as the transport seam carries it.
        type Response = http::Response<HttpBody>;
        /// Build a request URL from the base URL, or an optional per-operation server override, and a
        /// pre-rendered path plus pre-encoded query fragments. An absolute override replaces the client's
        /// base URL; a relative one is joined onto it. Paths compile to static segment concatenation — no
        /// runtime regex. Non-generic.
        ///
        /// `query` holds complete `name=value` fragments that the parameter helpers have already
        /// percent-encoded. They are installed verbatim rather than through `query_pairs_mut`, which would
        /// re-encode the style delimiters and make a `,` that joins two array items indistinguishable from
        /// a `,` inside one of them.
        pub fn build_url_on(
            core: &ClientCore,
            server: Option<&str>,
            path: &str,
            query: &[String],
        ) -> Result<Url, Error<Infallible>> {
            let mut url = base_for(core, server)?;
            let base_path = url.path().trim_end_matches('/');
            let request_path = path.trim_start_matches('/');
            let joined = if base_path.is_empty() {
                format!("/{request_path}")
            } else if request_path.is_empty() {
                base_path.to_owned()
            } else {
                format!("{base_path}/{request_path}")
            };
            if let Some(segment) = request_path
                .split(['/', '\\'])
                .find(|s| is_dot_segment(s))
            {
                return Err(
                    Error::request_message(
                        format!(
                            "request path contains the dot segment {segment:?}, which URL normalization would \
             remove and so send the request to a different resource"
                        ),
                    ),
                );
            }
            url.set_path(&joined);
            append_query(&mut url, query);
            Ok(url)
        }
        /// Whether `segment` is a `.` or `..` path segment under the URL Standard: `.` or `%2E`, or
        /// `..`, `.%2E`, `%2E.` or `%2E%2E`, each `%2E` matched ASCII case-insensitively. The URL parser
        /// deletes every ASCII tab, LF and CR before it reads a segment, so `.\t.` is `..` to it; they are
        /// deleted here first too.
        fn is_dot_segment(segment: &str) -> bool {
            let stripped: String;
            let segment = if segment.contains(['\t', '\n', '\r']) {
                stripped = segment
                    .chars()
                    .filter(|c| !matches!(c, '\t' | '\n' | '\r'))
                    .collect();
                stripped.as_str()
            } else {
                segment
            };
            let rest = segment.strip_prefix('.').or_else(|| strip_encoded_dot(segment));
            match rest {
                Some("") => true,
                Some(rest) => rest == "." || strip_encoded_dot(rest) == Some(""),
                None => false,
            }
        }
        /// `segment` without a leading `%2E` (either case), if it starts with one.
        fn strip_encoded_dot(segment: &str) -> Option<&str> {
            segment
                .get(..3)
                .filter(|prefix| prefix.eq_ignore_ascii_case("%2e"))
                .map(|_| &segment[3..])
        }
        /// Resolve the base URL for one request: the client's own, or a per-operation server override.
        fn base_for(
            core: &ClientCore,
            server: Option<&str>,
        ) -> Result<Url, Error<Infallible>> {
            match server {
                None => Ok(core.base_url().clone()),
                Some(server) => {
                    match Url::parse(server) {
                        Ok(absolute) => Ok(absolute),
                        Err(_) => {
                            core.base_url()
                                .join(server)
                                .map_err(Error::request_construction)
                        }
                    }
                }
            }
        }
        /// Append pre-encoded fragments to a URL, `&`-joined after any non-empty query the URL already
        /// carried. The new query is written into one buffer of exactly its length, and an empty `query`
        /// leaves the URL as it was.
        fn append_query<S: AsRef<str>>(url: &mut Url, query: &[S]) {
            if query.is_empty() {
                return;
            }
            let existing = url.query().filter(|existing| !existing.is_empty());
            let capacity = existing.map_or(0, |existing| existing.len() + 1)
                + query.iter().map(|fragment| fragment.as_ref().len()).sum::<usize>()
                + (query.len() - 1);
            let mut joined = String::with_capacity(capacity);
            if let Some(existing) = existing {
                joined.push_str(existing);
                joined.push('&');
            }
            for (index, fragment) in query.iter().enumerate() {
                if index > 0 {
                    joined.push('&');
                }
                joined.push_str(fragment.as_ref());
            }
            url.set_query(Some(&joined));
        }
        /// As [`build_url_on`], for a URL whose entire query string is owned by an OpenAPI 3.2
        /// `in: querystring` parameter. With or without a query string, it replaces any query embedded in
        /// the selected server URL.
        pub fn build_url_with_query_string_on(
            core: &ClientCore,
            server: Option<&str>,
            path: &str,
            query: &[String],
            query_string: Option<&str>,
        ) -> Result<Url, Error<Infallible>> {
            let mut url = build_url_on(core, server, path, &[])?;
            url.set_query(None);
            append_query(&mut url, query);
            if let Some(query_string) = query_string {
                append_query(&mut url, &[query_string]);
            }
            Ok(url)
        }
        /// Send a request built on the core's `reqwest::Client` through the core's transport
        /// [`super::HttpBackend`], mapping transport/timeout/protocol/redirect failures into the taxonomy.
        /// The request crosses the seam as an [`http::Request`] whose in-memory body moves without a copy
        /// off `wasm32`; a URL that is not a valid URI is refused first, as
        /// [`Error::RequestConstruction`]. The backend reports failures as a [`super::TransportError`]
        /// carrying its taxonomy class, which picks the variant here. Non-generic.
        ///
        /// A request that carries no total timeout of its own is given the core's
        /// [`super::ClientConfig::timeout`], read now, which bounds it until its whole response body has
        /// been read. An operation whose success response is a stream sends with [`send_streaming`]
        /// instead.
        pub async fn send(
            core: &ClientCore,
            mut request: Request,
        ) -> Result<http::Response<HttpBody>, Error<Infallible>> {
            if request.timeout().is_none() {
                *request.timeout_mut() = core.config().timeout;
            }
            send_streaming(core, request).await
        }
        /// [`send`] for a request whose success response is read as a stream (an `EventStream`): the
        /// core's [`super::ClientConfig::timeout`] is not applied, because a stream may rightly stay open
        /// indefinitely. A total timeout the request carries itself still applies, and the client's
        /// connect and read timeouts bound it as they bound every request. Non-generic.
        pub async fn send_streaming(
            core: &ClientCore,
            request: Request,
        ) -> Result<http::Response<HttpBody>, Error<Infallible>> {
            let request = request_from_reqwest(request).map_err(Error::from_reqwest)?;
            send_on(core.backend().as_ref(), request).await
        }
        /// [`send`] through the backend alone, for a caller that holds the backend and a request already
        /// on the seam rather than the whole [`ClientCore`]: a streaming response's reconnect.
        pub(crate) async fn send_on(
            backend: &dyn HttpBackend,
            request: http::Request<HttpBody>,
        ) -> Result<Response, Error<Infallible>> {
            backend.execute(request).await.map_err(Error::from_transport)
        }
        /// Decode a success response body into `T`, wrapping it with status and headers. Monomorphized once
        /// per body type. Decode failures become [`Error::Decode`] with serde's error message and a body
        /// capped at `max_error_body`. A zero-length body is not a JSON value, so it is always
        /// [`Error::Decode`], whatever `T` is.
        pub async fn decode_success<T>(
            core: &ClientCore,
            response: Response,
        ) -> Result<ResponseValue<T>, Error<Infallible>>
        where
            T: DeserializeOwned,
        {
            decode_success_with(
                    core,
                    response,
                    |body| {
                        serde_json::from_slice::<T>(body)
                            .map_err(|error| error.to_string())
                    },
                )
                .await
        }
        /// Decode a raw UTF-8 success body as the JSON string value described by a textual OpenAPI media
        /// type. Converting through `Value::String` keeps generated string enums and string formats typed
        /// while avoiding JSON's quote requirement on the wire. An empty body is decoded like any other
        /// (see [`decode_text_body`]): `String` yields `""`, a typed value with no empty member yields
        /// [`Error::Decode`].
        pub async fn decode_success_text<T>(
            core: &ClientCore,
            response: Response,
        ) -> Result<ResponseValue<T>, Error<Infallible>>
        where
            T: DeserializeOwned,
        {
            decode_success_with(core, response, |body| decode_text_body::<T>(body)).await
        }
        /// The body every structured success decoder shares: read the whole body, run `decode` over it, and
        /// wrap the value with status and headers. A decode failure becomes [`Error::Decode`] carrying the
        /// decoder's message as its `path` and a body capped at `max_error_body`. Deserialization needs the
        /// whole body, so peak memory here is inherent to typed decoding; only what the error *retains* is
        /// capped.
        ///
        /// Generated code for a multi-status success enum calls it from the arm whose selector matched,
        /// with a `decode` that builds that arm's variant. `decode` receives the `Bytes` itself so a raw
        /// binary variant keeps it without a copy.
        pub async fn decode_success_with<T>(
            core: &ClientCore,
            response: Response,
            decode: impl FnOnce(&Bytes) -> Result<T, String>,
        ) -> Result<ResponseValue<T>, Error<Infallible>> {
            let (parts, body) = response.into_parts();
            let (status, headers) = (parts.status, parts.headers);
            let body = body.collect().await.map_err(Error::from_transport)?;
            match decode(&body) {
                Ok(value) => Ok(ResponseValue::new(status, headers, value)),
                Err(path) => {
                    let (body, truncated) = cap_body(body, core.config().max_error_body);
                    Err(Error::Decode {
                        status,
                        headers,
                        path,
                        body,
                        truncated,
                    })
                }
            }
        }
        /// Decode a raw binary success body without attempting JSON deserialization. Every byte sequence
        /// is a valid binary body, so a zero-length one is an empty `Bytes`, never an error.
        pub async fn decode_success_bytes(
            core: &ClientCore,
            response: Response,
        ) -> Result<ResponseValue<Bytes>, Error<Infallible>> {
            decode_success_with(core, response, |body| Ok(body.clone())).await
        }
        /// Deserialize a raw UTF-8 body through a JSON string value. Exposed to the generated shim so
        /// multi-status response variants use exactly the same textual codec as single-body responses.
        ///
        /// An empty body is the zero-length text and is not special-cased: it becomes
        /// `Value::String("")`, so whether it decodes is `T`'s decision. `String` decodes it to `""` by
        /// design (as do `format: uuid`/`date-time`/`date`, which lower to `String` with the `uuid`/`time`
        /// features off), and so do an untyped schema's `Value` and a string enum with an empty variant; a
        /// string enum without one, `uuid::Uuid`, and the RFC 3339 `DateTime` / `Date` newtypes reject it
        /// with a decode failure. This is unlike the JSON and XML codecs, where an empty body is not a
        /// document and always fails. A documented bodyless status beside a documented body is a unit
        /// variant of the response enum, on the success side and the error side alike, and is not decoded
        /// here.
        pub fn decode_text_body<T>(body: &[u8]) -> Result<T, String>
        where
            T: DeserializeOwned,
        {
            let text = std::str::from_utf8(body).map_err(|error| error.to_string())?;
            serde_json::from_value(serde_json::Value::String(text.to_owned()))
                .map_err(|error| error.to_string())
        }
        /// Read a non-success response body capped at `max_error_body`, returning its status, headers, the
        /// (capped) bytes, and whether they were truncated: the read step of [`classify_with`]. The `E`
        /// parameter only threads the taxonomy through a transport failure while reading.
        pub(crate) async fn read_error_body<E>(
            core: &ClientCore,
            response: Response,
        ) -> Result<
            (reqwest::StatusCode, reqwest::header::HeaderMap, Bytes, bool),
            Error<E>,
        > {
            read_error_body_capped(core.config().max_error_body, response).await
        }
        /// [`read_error_body`] under an explicit `max_error_body` cap, for a caller that holds the cap
        /// rather than the whole [`ClientCore`].
        async fn read_error_body_capped<E>(
            max_error_body: usize,
            response: Response,
        ) -> Result<
            (reqwest::StatusCode, reqwest::header::HeaderMap, Bytes, bool),
            Error<E>,
        > {
            let (parts, body) = response.into_parts();
            let (body, truncated) = read_capped(max_error_body, body).await?;
            Ok((parts.status, parts.headers, body, truncated))
